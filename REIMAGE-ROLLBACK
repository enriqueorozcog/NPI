        estaciones_por_bu = {
            "SUR": ['MSRSFPREPARE', 'MSRSFPREPARE2', 'MSRSFFCT', 'MSRSFFCT2', 'MSRSFPROVISION', 'MSRSFREIMAGE', 'MSRSFREIMAGE2', 'MSRSFREIMAGE3', 'MSRSFROLLBACK', 'MSRSFROLLBACK2', 'MSRSFROLLBACK3'],
            "NFF": ['MSRSCPREPARE', 'MSRSCFT', 'MSRSCPROVISION', 'MSRSCREIMAGE', 'MSRSCREIMAGE2', 'MSRSCROLLBACK'],
            "IRR": ['MSRIRRPREPARE', 'MSRIRRPREPARE2', 'MSRIRRFCT', 'MSRIRRFCT2', 'MSRIRRFCT3', 'MSRIRRPROVISION', 'MSRIRRREIMAGE', 'MSRIRRREIMAGE2', 'MSRIRRREIMAGE3', 'MSRIRRROLLBACK', 'MSRIRRROLLBACK2', 'MSRIRRROLLBACK3']
        }

        bu_seleccionada = self.cmb_bu.get()
        lista_estaciones = estaciones_por_bu.get(bu_seleccionada, estaciones_por_bu["SUR"])
        
        fecha_ini = self.date_start.get_date().strftime('%Y-%m-%d')
        fecha_fin = self.date_end.get_date().strftime('%Y-%m-%d')

        mapped_records = []
        error_msg = None

        try:
            connection = oracledb.connect(
                user=self.db_config["user"],
                password=self.db_config["password"],
                host=self.db_config["host"],
                port=int(self.db_config["port"]),
                service_name=self.db_config["service_name"]
            )
            cursor = connection.cursor()
            
            placeholders = [f":est{i}" for i in range(len(lista_estaciones))]
            in_clause = ",".join(placeholders)

            query = f"""
                SELECT 
                    SERIAL_NR AS "Serial",
                    CURR_STATUS AS "Station",
                    'TEST' AS "Test",
                    MEMO AS "Result",
                    TO_CHAR(CT_DATE, 'YYYY-MM-DD HH24:MI:SS') AS "Timestamp",
                    'Operator' AS "User"
                FROM ERS.ERS_ITEM_TRACK
                WHERE CURR_STATUS IN ({in_clause})
                  AND TRUNC(CT_DATE) BETWEEN TO_DATE(:f_inicio, 'YYYY-MM-DD') AND TO_DATE(:f_fin, 'YYYY-MM-DD')
                ORDER BY CT_DATE ASC
            """
            
            parametros_query = {f"est{i}": est for i, est in enumerate(lista_estaciones)}
            parametros_query["f_inicio"] = fecha_ini
            parametros_query["f_fin"] = fecha_fin

            cursor.execute(query, parametros_query)
            raw_data = cursor.fetchall()

            for row in raw_data:
                mapped_records.append({
                    "Serial": str(row[0]),
                    "Station": str(row[1]),
                    "Test": str(row[2]),
                    "Result": str(row[3]),
                    "Timestamp": str(row[4]),
                    "User": str(row[5])
                })

            cursor.close()
            connection.close()

        except Exception as e:
            error_msg = str(e)

        self.root.after(0, lambda: self.finalize_data_load(mapped_records, error_msg, is_automated))

    def finalize_data_load(self, mapped_records, error_msg, is_automated):
        """Devuelve el control al hilo de ejecución de Tkinter actualizando la barra de estatus."""
        self.is_scanning = False
        ld = self.lang_dict[self.current_lang]
        
        if not is_automated:
            self.progress.stop()
            self.btn_scan.config(state="normal", text=ld["scan"])
        
        if error_msg:
            self.lbl_status_msg.config(text=ld["status_disconnected"], fg=self.themes["light"]["danger"])
            if not is_automated:
                messagebox.showerror("Database Error", f"Fallo al conectar con Oracle: {error_msg}")
            return

        # Guardamos el paquete íntegro de datos descargados
        self.records = mapped_records
        
        # Sincronizamos la estampa de tiempo en la barra inferior (UX)
        current_time_str = datetime.datetime.now().strftime("%H:%M:%S")
        self.lbl_status_msg.config(text=f"{ld['status_connected']}{current_time_str}", fg=self.themes["light"]["muted"])

        # Forzamos el filtrado local. Él se encargará de segmentar por turno, calcular KPIs y dibujar gráficos.
        self.filter_records()


