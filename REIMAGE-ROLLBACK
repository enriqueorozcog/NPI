    def init_database(self):
        """Conexión local SQLite para almacenamiento en caché de contingencia."""
        self.conn = sqlite3.connect("npi_automated_quality.db")
        self.cursor_local = self.conn.cursor()
        self.cursor_local.execute("""
            CREATE TABLE IF NOT EXISTS server_logs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                serial TEXT NOT NULL,
                model TEXT NOT NULL,
                test TEXT NOT NULL,
                result TEXT NOT NULL,
                datetime TEXT NOT NULL,
                user TEXT NOT NULL,
                UNIQUE(serial, datetime)
            )
        """)
        self.conn.commit()


