    # ======================================================
    # MÉTRICAS ANALÍTICAS Y RENDIMIENTO DE GRÁFICAS DE DOBLE EJE
    # ======================================================

    def update_dashboard_metrics(self, total_pass, total_fail):
        """Calcula las métricas y aplica alertas visuales por rangos de color al Yield."""
        total_records = total_pass + total_fail
        yield_rate = 0.0
        if total_records > 0:
            yield_rate = round((total_pass / total_records) * 100, 2)

        self.lbl_card_total_val.config(text=str(total_records))
        self.lbl_card_pass_val.config(text=str(total_pass))
        self.lbl_card_fail_val.config(text=str(total_fail))
        self.lbl_card_yield_val.config(text=f"{yield_rate}%")

        # CONFIGURACIÓN SEGURO DE ALERTAS POR COLORES (KPI DE PLANTA)
        t = self.themes["light"]
        if total_records == 0:
            self.card_yield.config(bg=t["surface"])
            self.lbl_card_yield_title.config(bg=t["surface"], fg=t["text"])
            self.lbl_card_yield_val.config(bg=t["surface"], fg=t["text"])
        elif yield_rate >= 95.0:
            self.card_yield.config(bg=t["success_bg"])
            self.lbl_card_yield_title.config(bg=t["success_bg"], fg=t["success"])
            self.lbl_card_yield_val.config(bg=t["success_bg"], fg=t["success"])
        elif yield_rate >= 85.0:
            self.card_yield.config(bg=t["warning_bg"])
            self.lbl_card_yield_title.config(bg=t["warning_bg"], fg=t["warning"])
            self.lbl_card_yield_val.config(bg=t["warning_bg"], fg=t["warning"])
        else:
            self.card_yield.config(bg=t["danger_bg"])
            self.lbl_card_yield_title.config(bg=t["danger_bg"], fg=t["danger"])
            self.lbl_card_yield_val.config(bg=t["danger_bg"], fg=t["danger"])

    def refresh_chart(self, total_pass, total_fail):
        """Redibuja de forma dinámica la gráfica de barras de Matplotlib."""
        self.ax.clear()
        t = self.themes["light"]
        
        self.fig.patch.set_facecolor(t["surface"])
        self.ax.set_facecolor(t["surface_2"])
        
        categories = ["Pass (OK)", "Fail (FAIL)"]
        values = [total_pass, total_fail]
        bar_colors = [t["success"], t["danger"]]

        bars = self.ax.barh(categories, values, color=bar_colors, height=0.55)
        
        self.ax.tick_params(colors=t["text"], labelsize=9)
        self.ax.spines['top'].set_visible(False)
        self.ax.spines['right'].set_visible(False)
        self.ax.spines['left'].set_color(t["border"])
        self.ax.spines['bottom'].set_color(t["border"])
        self.ax.grid(axis='x', color=t["border"], linestyle='--', alpha=0.5)

        for bar in bars:
            width = bar.get_width()
            self.ax.text(
                width + (max(values)*0.02 if max(values) > 0 else 0.1),
                bar.get_y() + bar.get_height()/2,
                f'{int(width)}',
                va='center', ha='left',
                color=t["text"], fontweight='bold', fontsize=9
            )

        self.fig.tight_layout()
        self.canvas_plot.draw()

    def refresh_pareto_chart(self):
        """Dibuja un Diagrama de Pareto legítimo con nombres rotados y línea de corte del 80%."""
        self.ax_pareto_bars.clear()
        
        for ax in self.fig_pareto.get_axes():
            if ax is not self.ax_pareto_bars:
                ax.remove()

        t = self.themes["light"]
        self.fig_pareto.patch.set_facecolor(t["surface"])
        self.ax_pareto_bars.set_facecolor(t["surface_2"])

        if not self.top_failures:
            self.ax_pareto_bars.text(0.5, 0.5, "0 DEFECTOS\nLínea Estable (100% OK)", 
                                     ha='center', va='center', color=t["success"], fontweight='bold')
            self.ax_pareto_bars.axis('off')
            self.canvas_pareto.draw()
            return

        self.ax_pareto_bars.axis('on')
        stations = [str(st) for st, _ in self.top_failures]
        counts = [count for _, count in self.top_failures]
        
        self.ax_pareto_bars.bar(stations, counts, color="#FF9500", alpha=0.85, width=0.45, edgecolor="#E68200")
        self.ax_pareto_bars.set_ylabel("Frecuencia (Fallas)", color="#E68200", fontweight="bold", fontsize=9)
        self.ax_pareto_bars.tick_params(axis='y', labelcolor="#E68200", labelsize=8)
        self.ax_pareto_bars.set_xticklabels(stations, rotation=45, ha='right', rotation_mode='anchor')
        self.ax_pareto_bars.tick_params(axis='x', labelcolor=t["text"], labelsize=7)

        # Calcular porcentajes acumulados matemáticos para la curva
        total_failures = sum(counts)
        cumulative_percentages = []
        running_sum = 0
        for c in counts:
            running_sum += c
            cumulative_percentages.append((running_sum / total_failures) * 100)

        # 2. Eje Y Derecho: Línea de porcentaje acumulado (Curva de Pareto)
        ax_curve = self.ax_pareto_bars.twinx()
        ax_curve.plot(stations, cumulative_percentages, color="#007AFF", marker="o", linewidth=1.5, ms=4)
        ax_curve.set_ylabel("Porcentaje Acumulado", color="#007AFF", fontweight="bold", fontsize=9)
        ax_curve.tick_params(axis='y', labelcolor="#007AFF", labelsize=8)
        ax_curve.set_ylim(0, 105)

        # Inyección de la línea horizontal de control del 80% en color rojo
        ax_curve.axhline(80, color=t["danger"], linestyle="--", linewidth=1.2, alpha=0.85)

        self.ax_pareto_bars.spines['top'].set_visible(False)
        ax_curve.spines['top'].set_visible(False)
        self.ax_pareto_bars.spines['left'].set_color(t["border"])
        self.ax_pareto_bars.spines['bottom'].set_color(t["border"])
        ax_curve.spines['right'].set_color(t["border"])
        self.ax_pareto_bars.grid(axis='y', color=t["border"], linestyle='--', alpha=0.4)

        self.fig_pareto.tight_layout()
        self.canvas_pareto.draw()

    # ======================================================
    # LÓGICA DE FILTRADO MULTINIVEL E INYECCIÓN DE TURNOS DE PLANTA
    # ======================================================

    def filter_records(self):
        """Filtra en caliente por texto, estatus y turno recalculando KPIs y gráficas al vuelo."""
        search_txt = self.search_var.get().upper()
        status_filter = self.cmb_status.get()
        shift_filter = self.cmb_shift.get()
        
        # Limpiar tabla visual por completo
        for item in self.tree.get_children():
            self.tree.delete(item)

        self.filtered_records = []
        
        # Diccionario de traducción inversa para amarrar la validación horaria local
        ld = self.lang_dict[self.current_lang]

        for row in self.records:
            # 1. Extracción de estampa de tiempo del formato 'YYYY-MM-DD HH24:MI:SS'
            try:
                time_part = row["Timestamp"].split(" ")[1] # Extrae 'HH:MM:SS'
                h, m, s = map(int, time_part.split(":"))
                record_time = datetime.time(h, m, s)
            except Exception:
                record_time = datetime.time(0, 0, 0)

            # 2. Filtrado Matemático Estricto por Turno de Producción (UX)
            match_shift = True
            if shift_filter in [ld["shift_1"], "1er Turno", "1st Shift"]:
                if not (datetime.time(6, 0, 0) <= record_time < datetime.time(15, 30, 0)):
                    match_shift = False
            elif shift_filter in [ld["shift_2"], "2do Turno", "2nd Shift"]:
                if not (datetime.time(15, 30, 0) <= record_time < datetime.time(23, 54, 0)):
                    match_shift = False
            elif shift_filter in [ld["shift_3"], "3er Turno", "3rd Shift"]:
                # Caso Especial: El tercer turno cruza de forma natural la medianoche
                if not (record_time >= datetime.time(23, 54, 0) or record_time < datetime.time(6, 0, 0)):
                    match_shift = False

            # 3. Filtrado por Estatus Base (Pass/Fail)
            match_status = True
            if status_filter in ["Pass", "OK", "Aprobados"] and row["Result"] != "OK":
                match_status = False
            elif status_filter in ["Fail", "FAIL", "Fallados"] and row["Result"] != "FAIL":
                match_status = False

            # 4. Filtrado por Cuadro de Búsqueda Rápida en Caliente
            match_text = search_txt in row["Serial"].upper() or search_txt in row["Station"].upper()

            if match_shift and match_status and match_text:
                self.filtered_records.append(row)

        # RECALCULAR CONTADORES DE MÉTRICAS EXCLUSIVOS PARA EL TURNO EN PANTALLA
        total_pass = sum(1 for r in self.filtered_records if r["Result"] == "OK")
        total_fail = sum(1 for r in self.filtered_records if r["Result"] == "FAIL")
        
        self.update_dashboard_metrics(total_pass, total_fail)
        self.refresh_chart(total_pass, total_fail)

        # RECALCULAR GRAFICA DE PARETO EXCLUSIVA PARA EL TURNO EN PANTALLA
        failure_counts = {}
        for r in self.filtered_records:
            if r["Result"] == "FAIL":
                station = r["Station"]
                failure_counts[station] = failure_counts.get(station, 0) + 1
        self.top_failures = sorted(failure_counts.items(), key=lambda x: x, reverse=True)
        self.refresh_pareto_chart()

        # Inyectar las filas segmentadas en el Treeview con protección de memoria a 1000 registros
        inserted_count = 0
        for row in self.filtered_records:
            if inserted_count >= 1000:
                break
            self.tree.insert("", "end", values=(
                row["Serial"], row["Station"], row["Test"], row["Result"], row["Timestamp"], row["User"]
            ))
            inserted_count += 1


