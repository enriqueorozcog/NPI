        self.btn_theme.config(text="☀" if self.dark_mode else "☾")

        self.status_filter["values"] = (ld["all"], ld["pass"], ld["fail"])

        if not self.status_filter.get():
            self.status_filter.set(ld["all"])
        else:
            current_status = self.get_selected_status()
            self.status_filter.set(ld["all"] if current_status == "All" else (ld["pass"] if current_status == "Pass" else ld["fail"]))

        columns = ("serial", "model", "test", "result", "datetime", "user")
        headers = [ld["serial"], ld["model"], ld["test"], ld["result"], ld["datetime"], ld["user"]]
        widths = [150, 140, 120, 95, 160, 135]

        for col, header, width in zip(columns, headers, widths):
            self.tree.heading(col, text=header, anchor="w")
            self.tree.column(col, width=width, minwidth=90, stretch=True, anchor="w")

