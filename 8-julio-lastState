    def sort_column_data(self, col_key):
        """Ordena los registros en memoria de forma instantánea de la A a la Z o viceversa."""
        if not self.filtered_records:
            return

        # Alternar la dirección de ordenamiento registrada para esa columna
        current_dir = self.sort_directions.get(col_key, False)
        new_dir = not current_dir
        self.sort_directions[col_key] = new_dir

        # Mapear la clave de la columna del Treeview al diccionario de datos
        key_map = {
            "serial": "Serial", "station": "Station", "test": "Test",
            "result": "Result", "timestamp": "Timestamp", "user": "User"
        }
        data_key = key_map.get(col_key, "Timestamp")

        # Ordenar la lista en memoria usando una función lambda
        self.filtered_records.sort(key=lambda x: x[data_key].upper(), reverse=new_dir)

        # Volver a pintar los registros ordenados en la tabla visual
        for item in self.tree.get_children():
            self.tree.delete(item)

        inserted_count = 0
        for row in self.filtered_records:
            if inserted_count >= 1000:
                break
            self.tree.insert("", "end", values=(
                row["Serial"], row["Station"], row["Test"], row["Result"], row["Timestamp"], row["User"]
            ))
            inserted_count += 1

    # ======================================================
    # LÓGICA DE FILTRADO LOCAL AVANZADA CON ALGORITMO FPY
    # ======================================================

    def filter_records(self):
        """Filtra por texto, estatus, turno, consolida unidades únicas y extrae la métrica FPY."""
        search_txt = self.search_var.get().upper()
        status_filter = self.cmb_status.get()
        shift_filter = self.cmb_shift.get()
        view_mode_filter = self.cmb_view_mode.get()
        
        for item in self.tree.get_children():
            self.tree.delete(item)

        self.filtered_records = []
        ld = self.lang_dict[self.current_lang]
        
        # 📊 ALGORITMO FPY Y UNIDADES ÚNICAS: Mapeo de historiales cronológicos
        # Primero agrupamos TODO el lote base descargado por número de serie para estudiar reintentos
        history_by_serial = {}
        for row in self.records:
            sn = row["Serial"]
            if sn not in history_by_serial:
                history_by_serial[sn] = []
            history_by_serial[sn].append(row)

        # Ordenar internamente el historial de cada serie por marca de tiempo cronológica
        for sn in history_by_serial:
            history_by_serial[sn].sort(key=lambda x: x["Timestamp"])

        # Determinar el lote objetivo de registros a evaluar según el Modo Vista seleccionado
        target_records = []
        if view_mode_filter in [ld["view_unique"], "Unidades Únicas (Último Estado)", "Unique Units (Last State)"]:
            # Conservamos estrictamente el ÚLTIMO estado cronológico de cada unidad física única
            for sn, rows in history_by_serial.items():
                target_records.append(rows[-1])
        else:
            # Modo intentos crudos tradicional
            target_records = self.records

        # BUCLE PRINCIPAL DE SEGMENTACIÓN EN MEMORIA (TURNO, TEXTO Y ESTATUS)
        for row in target_records:
            try:
                time_part = row["Timestamp"].split(" ")[1]
                h, m, s = map(int, time_part.split(":"))
                record_time = datetime.time(h, m, s)
            except Exception:
                record_time = datetime.time(0, 0, 0)

            # Filtrado por Turno de Producción (Validación Horaria)
            match_shift = True
            if shift_filter in [ld["shift_1"], "1er Turno", "1st Shift"]:
                if not (datetime.time(6, 0, 0) <= record_time < datetime.time(15, 30, 0)):
                    match_shift = False
            elif shift_filter in [ld["shift_2"], "2do Turno", "2nd Shift"]:
                if not (datetime.time(15, 30, 0) <= record_time < datetime.time(23, 54, 0)):
                    match_shift = False
            elif shift_filter in [ld["shift_3"], "3er Turno", "3rd Shift"]:
                if not (record_time >= datetime.time(23, 54, 0) or record_time < datetime.time(6, 0, 0)):
                    match_shift = False

            # Filtrado por Estatus Base (Pass/Fail)
            match_status = True
            if status_filter in ["Pass", "OK", "Aprobados"] and row["Result"] != "OK":
                match_status = False
            elif status_filter in ["Fail", "FAIL", "Fallados"] and row["Result"] != "FAIL":
                match_status = False

            # Filtrado por Cuadro de Búsqueda Rápida en Caliente
            match_text = search_txt in row["Serial"].upper() or search_txt in row["Station"].upper()

            if match_shift and match_status and match_text:
                self.filtered_records.append(row)

        # 🧠 CÁLCULO DE FIRST PASS YIELD (FPY): Analizar el primer intento de las piezas filtradas
        fpy_rate = None
        if self.filtered_records:
            # Extraemos los números de serie únicos presentes en la selección actual
            unique_serials_in_view = set(r["Serial"] for r in self.filtered_records)
            fpy_pass_count = 0
            
            for sn in unique_serials_in_view:
                # Consultamos el primer intento absoluto de esta pieza en su historial original
                full_history = history_by_serial.get(sn, [])
                if full_history:
                    first_attempt = full_history[0]
                    if first_attempt["Result"] == "OK":
                        fpy_pass_count += 1
            
            fpy_rate = round((fpy_pass_count / len(unique_serials_in_view)) * 100, 2)

        # RECALCULAR CONTADORES NUMÉRICOS INYECTANDO LA EFICIENCIA FPY REVELADA
        total_pass = sum(1 for r in self.filtered_records if r["Result"] == "OK")
        total_fail = sum(1 for r in self.filtered_records if r["Result"] == "FAIL")
        
        self.update_dashboard_metrics(total_pass, total_fail, fpy_rate=fpy_rate)
        self.refresh_chart(total_pass, total_fail)

        # RECALCULAR MAPA DE FALLAS EXCLUSIVO DE ESTA SELECCIÓN
        failure_counts = {}
        for r in self.filtered_records:
            if r["Result"] == "FAIL":
                station = r["Station"]
                failure_counts[station] = failure_counts.get(station, 0) + 1
        self.top_failures = sorted(failure_counts.items(), key=lambda x: x[1], reverse=True)
        self.refresh_pareto_chart()

        # Inserción visual en Treeview acotada a un límite seguro de 1000 filas
        inserted_count = 0
        for row in self.filtered_records:
            if inserted_count >= 1000:
                break
            self.tree.insert("", "end", values=(
                row["Serial"], row["Station"], row["Test"], row["Result"], row["Timestamp"], row["User"]
            ))
            inserted_count += 1


