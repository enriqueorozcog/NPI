    def start_async_load(self, is_automated=False):
        """Dispara la consulta en segundo plano liberando los filtros y botones en caliente."""
        if self.is_scanning:
            return 
            
        self.is_scanning = True
        
        if not is_automated:
            self.btn_scan.config(state="disabled", text="Cargando..." if self.current_lang == "ESP" else "Loading...")
            self.progress.start(10)
        
        t = threading.Thread(target=self.load_data_thread, args=(is_automated,), daemon=True)
        t.start()

    def load_data_thread(self, is_automated):
        """Consulta remota multinivel tolerante a fallas con cronómetro interno de red."""
        estaciones_por_bu = {
            "SUR": [
                'MSRSFPREPARE', 'MSRSFPREPARE2', 'MSRSFFCT', 'MSRSFFCT2', 'MSRSFPROVISION', 
                'MSRSFREIMAGE', 'MSRSFREIMAGE2', 'MSRSFREIMAGE3', 'MSRSFROLLBACK', 'MSRSFROLLBACK2', 'MSRSFROLLBACK3'
            ],
            "NFF": [
                'MSRSCPREPARE', 'MSRSCFT', 'MSRSCPROVISION', 'MSRSCREIMAGE', 'MSRSCREIMAGE2', 'MSRSCROLLBACK'
            ],
            "IRR": [
                'MSRIRRPREPARE', 'MSRIRRPREPARE2', 'MSRIRRFCT', 'MSRIRRFCT2', 'MSRIRRFCT3', 'MSRIRRPROVISION', 
                'MSRIRRREIMAGE', 'MSRIRRREIMAGE2', 'MSRIRRREIMAGE3', 'MSRIRRROLLBACK', 'MSRIRRROLLBACK2', 'MSRIRRROLLBACK3'
            ]
        }

        bu_seleccionada = self.cmb_bu.get()
        lista_estaciones = estaciones_por_bu.get(bu_seleccionada, estaciones_por_bu["SUR"])
        
        fecha_ini = self.date_start.get_date().strftime('%Y-%m-%d')
        fecha_fin = self.date_end.get_date().strftime('%Y-%m-%d')

        mapped_records = []
        is_contingency = False
        execution_time = 0.0

        try:
            # ⏱️ MEDIDOR DE TIEMPO: Inicia el cronómetro antes de conectar a Oracle
            start_time = time.time()
            
            connection = oracledb.connect(
                user=self.db_config["user"],
                password=self.db_config["password"],
                host=self.db_config["host"],
                port=int(self.db_config["port"]),
                service_name=self.db_config["service_name"]
            )
            cursor = connection.cursor()
            
            placeholders = [f":est{i}" for i in range(len(lista_estaciones))]
            in_clause = ",".join(placeholders)

            query = f"""
                SELECT SERIAL_NR, CURR_STATUS, 'TEST', MEMO, TO_CHAR(CT_DATE, 'YYYY-MM-DD HH24:MI:SS'), 'Operator'
                FROM ERS.ERS_ITEM_TRACK
                WHERE CURR_STATUS IN ({in_clause})
                  AND TRUNC(CT_DATE) BETWEEN TO_DATE(:f_inicio, 'YYYY-MM-DD') AND TO_DATE(:f_fin, 'YYYY-MM-DD')
                ORDER BY CT_DATE ASC
            """
            
            parametros_query = {f"est{i}": est for i, est in enumerate(lista_estaciones)}
            parametros_query["f_inicio"] = fecha_ini
            parametros_query["f_fin"] = fecha_fin

            cursor.execute(query, parametros_query)
            raw_data = cursor.fetchall()
            
            execution_time = round(time.time() - start_time, 2)

            # 🛡️ MIRRORING EN CALIENTE: Guardar los datos exitosos en la caché local SQLite
            for row in raw_data:
                mapped_records.append({
                    "Serial": str(row[0]), "Station": str(row[1]), "Test": str(row[2]),
                    "Result": str(row[3]), "Timestamp": str(row[4]), "User": str(row[5])
                })
                try:
                    self.cursor_local.execute("""
                        INSERT OR IGNORE INTO server_logs (serial, station, test, result, datetime, operator, bu)
                        VALUES (?, ?, ?, ?, ?, ?, ?)
                    """, (str(row[0]), str(row[1]), str(row[2]), str(row[3]), str(row[4]), str(row[5]), bu_seleccionada))
                except Exception:
                    pass
            self.conn.commit()
            cursor.close()
            connection.close()

        except Exception as e:
            # 🚨 MODO CONTINGENCIA: Si Oracle falla, rescatamos la caché de SQLite automáticamente
            is_contingency = True
            mapped_records = []
            try:
                placeholders = ",".join(["?"] * len(lista_estaciones))
                local_query = f"""
                    SELECT serial, station, test, result, datetime, operator 
                    FROM server_logs 
                    WHERE bu = ? AND station IN ({placeholders})
                      AND SUBSTR(datetime, 1, 10) BETWEEN ? AND ?
                    ORDER BY datetime ASC
                """
                params = [bu_seleccionada] + lista_estaciones + [fecha_ini, fecha_fin]
                self.cursor_local.execute(local_query, params)
                local_data = self.cursor_local.fetchall()
                for r in local_data:
                    mapped_records.append({
                        "Serial": str(r[0]), "Station": str(r[1]), "Test": str(r[2]),
                        "Result": str(r[3]), "Timestamp": str(r[4]), "User": str(r[5])
                    })
            except Exception as ex:
                print(f"Fallo crítico leyendo caché SQLite local: {ex}")

        self.root.after(0, lambda: self.finalize_data_load(mapped_records, is_contingency, execution_time, is_automated))

    def finalize_data_load(self, mapped_records, is_contingency, execution_time, is_automated):
        """Devuelve el control a Tkinter inyectando las marcas de tiempo y métricas."""
        self.is_scanning = False
        ld = self.lang_dict[self.current_lang]
        
        if not is_automated:
            self.progress.stop()
            self.btn_scan.config(state="normal", text=ld["scan"])
        
        self.records = mapped_records
        current_time_str = datetime.datetime.now().strftime("%H:%M:%S")

        # Actualiza barra de estatus inferior informando el tiempo de respuesta o el estado de contingencia
        if is_contingency:
            self.lbl_status_msg.config(text=f"{ld['status_contingency']}{current_time_str}", fg="#FF9500")
        else:
            self.lbl_status_msg.config(text=f"{ld['status_connected']}{current_time_str} | Response: {execution_time}s", fg="#6E6E73")

        # Forzamos la actualización visual reactiva
        self.filter_records()


