        if fpy_rate is not None:
            self.lbl_card_yield_val.config(text=f"{yield_rate}%\n(FPY: {fpy_rate}%)", font=("Segoe UI", 16, "bold"))
        else:
            self.lbl_card_yield_val.config(text=f"{yield_rate}%", font=("Segoe UI", 24, "bold"))

