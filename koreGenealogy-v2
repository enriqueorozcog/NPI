import customtkinter as ctk
import oracledb
import requests
import os
from tkinter import messagebox

# Configuración CustomTkinter
ctk.set_appearance_mode("Dark")  # Modo oscuro
ctk.set_default_color_theme("blue")

class GenealogiaApp(ctk.CTk):
