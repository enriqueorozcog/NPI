        self.lbl_motherboard, self.lbl_motherboard_value = self.crear_campo(self.card_components, "Motherboard:", "--")
        self.lbl_battery, self.lbl_battery_value = self.crear_campo(self.card_components, "Batería:", "--")
        self.lbl_display, self.lbl_display_value = self.crear_campo(self.card_components, "Display:", "--")
