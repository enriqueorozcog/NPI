    def run_live_loop(self):
        """Dispara de forma silenciosa una recarga automática en segundo plano cada 30 segundos."""
        if self.live_mode and not self.is_scanning: 
            self.start_async_load(is_automated=True)
            
        self.root.after(30000, self.run_live_loop)

