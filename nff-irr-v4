            story.append(Image(temp_img_path, width=460, height=202))
            story.append(Spacer(1, 20))

            story.append(Paragraph("<b>Detailed Inspection Records (Sample):</b>", styles['Heading3']))
            story.append(Spacer(1, 8))
            
            table_data = [["Serial No", "Station / Process", "Test Action", "Result Code", "Timestamp"]]
