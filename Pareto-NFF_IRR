    def start_async_load(self, is_automated=False):
        """Dispara la consulta en segundo plano liberando los filtros y botones en caliente."""
        if self.is_scanning:
            return 
            
        self.is_scanning = True
        
        if not is_automated:
            self.btn_scan.config(state="disabled", text="Cargando..." if self.current_lang == "ESP" else "Loading...")
            self.progress.start(10)
        
        t = threading.Thread(target=self.load_data_thread, args=(is_automated,), daemon=True)
        t.start()

    def load_data_thread(self, is_automated):
        """Consulta remota multinivel con transformación nativa a diccionarios de datos."""
        estaciones_por_bu = {
            "SUR": ['MSRSFPREPARE', 'MSRSFPREPARE2', 'MSRSFFCT', 'MSRSFFCT2', 'MSRSFPROVISION'],
            "NFF": ['MSRSCPREPARE', 'MSRSCFT', 'MSRSCPROVISION'],
            "IRR": ['MSRIRRPREPARE', 'MSRIRRPREPARE2', 'MSRIRRFCT', 'MSRIRRFCT2', 'MSRIRRFCT3', 'MSRIRRPROVISION']
        }

        bu_seleccionada = self.cmb_bu.get()
        lista_estaciones = estaciones_por_bu.get(bu_seleccionada, estaciones_por_bu["SUR"])
        
        fecha_ini = self.date_start.get_date().strftime('%Y-%m-%d')
        fecha_fin = self.date_end.get_date().strftime('%Y-%m-%d')

        mapped_records = []
        error_msg = None

        try:
            connection = oracledb.connect(
                user=self.db_config["user"],
                password=self.db_config["password"],
                host=self.db_config["host"],
                port=int(self.db_config["port"]),
                service_name=self.db_config["service_name"]
            )
            cursor = connection.cursor()
            
            placeholders = [f":est{i}" for i in range(len(lista_estaciones))]
            in_clause = ",".join(placeholders)

            query = f"""
                SELECT 
                    SERIAL_NR AS "Serial",
                    CURR_STATUS AS "Station",
                    'TEST' AS "Test",
                    MEMO AS "Result",
                    TO_CHAR(CT_DATE, 'YYYY-MM-DD HH24:MI:SS') AS "Timestamp",
                    'Operator' AS "User"
                FROM ERS.ERS_ITEM_TRACK
                WHERE CURR_STATUS IN ({in_clause})
                  AND TRUNC(CT_DATE) BETWEEN TO_DATE(:f_inicio, 'YYYY-MM-DD') AND TO_DATE(:f_fin, 'YYYY-MM-DD')
                ORDER BY CT_DATE ASC
            """
            
            parametros_query = {f"est{i}": est for i, est in enumerate(lista_estaciones)}
            parametros_query["f_inicio"] = fecha_ini
            parametros_query["f_fin"] = fecha_fin

            cursor.execute(query, parametros_query)
            raw_data = cursor.fetchall()

            for row in raw_data:
                mapped_records.append({
                    "Serial": str(row[0]),
                    "Station": str(row[1]),
                    "Test": str(row[2]),
                    "Result": str(row[3]),
                    "Timestamp": str(row[4]),
                    "User": str(row[5])
                })

            cursor.close()
            connection.close()

        except Exception as e:
            error_msg = str(e)

        self.root.after(0, lambda: self.finalize_data_load(mapped_records, error_msg, is_automated))

    def finalize_data_load(self, mapped_records, error_msg, is_automated):
        """Devuelve el control al hilo de ejecución de Tkinter de forma segura."""
        self.is_scanning = False
        
        if not is_automated:
            self.progress.stop()
            ld = self.lang_dict[self.current_lang]
            self.btn_scan.config(state="normal", text=ld["scan"])
        
        if error_msg:
            if not is_automated:
                messagebox.showerror("Database Error", f"Fallo al conectar con Oracle: {error_msg}")
            return

        self.records = mapped_records
        
        total_pass = sum(1 for r in self.records if r["Result"] == "OK")
        total_fail = sum(1 for r in self.records if r["Result"] == "FAIL")

        # CÁLCULO DE PARETO: Contar y ordenar fallas agrupadas por estación
        failure_counts = {}
        for r in self.records:
            if r["Result"] == "FAIL":
                station = r["Station"]
                failure_counts[station] = failure_counts.get(station, 0) + 1
        
        # Ordenar de mayor a menor volumen de fallas
        self.top_failures = sorted(failure_counts.items(), key=lambda x: x[1], reverse=True)

        self.update_dashboard_metrics(total_pass, total_fail)
        self.refresh_chart(total_pass, total_fail)
        self.refresh_pareto_chart() # Renderiza el Diagrama de Pareto Industrial
        self.filter_records()


