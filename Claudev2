    def init_database(self):
        self.conn = sqlite3.connect("npi_automated_quality.db", check_same_thread=False)
        self.cursor_local = self.conn.cursor()
        self.cursor_local.execute("""
            CREATE TABLE IF NOT EXISTS server_logs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                serial TEXT NOT NULL, station TEXT NOT NULL, test TEXT NOT NULL,
                result TEXT NOT NULL, datetime TEXT NOT NULL, operator TEXT NOT NULL, bu TEXT NOT NULL,
                UNIQUE(serial, datetime, station)
            )
        """)
        self.conn.commit()

