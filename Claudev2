            if not sorted_dates:
                tk.Label(scroll_content, text="[ SIN REGISTROS EN ESTE RANGO ]", font=("Segoe UI", 11, "bold"), bg=t["window"], fg=t["muted"]).pack(padx=50, pady=50)
