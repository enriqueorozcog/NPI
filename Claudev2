                    tk.Frame(rows_scroll_frame, height=1, bg=t["surface_2"]).pack(fill="x")

            scroll_content.update_idletasks()
            canvas.configure(scrollregion=canvas.bbox("all"))

        cmb_dash_bu.bind("<<ComboboxSelected>>", lambda e: calculate_and_draw_cards())
        cmb_dash_shift.bind("<<ComboboxSelected>>", lambda e: calculate_and_draw_cards())
        cmb_dash_status.bind("<<ComboboxSelected>>", lambda e: calculate_and_draw_cards())
        dash_start.bind("<<DateEntrySelected>>", lambda e: calculate_and_draw_cards())
        dash_end.bind("<<DateEntrySelected>>", lambda e: calculate_and_draw_cards())
        btn_calc.config(command=calculate_and_draw_cards)
        calculate_and_draw_cards()

    def sort_column_data(self, col_key):
        """Ordena los registros en memoria de forma instantánea de la A a la Z o viceversa."""
        if not self.filtered_records: return
        d = not self.sort_directions[col_key]
        self.sort_directions[col_key] = d
        k = {"serial": "Serial", "station": "Station", "test": "Test", "result": "Result",
             "timestamp": "Timestamp", "user": "User"}[col_key]
        self.filtered_records.sort(key=lambda x: str(x[k]).upper(), reverse=d)
        for item in self.tree.get_children(): self.tree.delete(item)
        for r in self.filtered_records[:1000]:
            self.tree.insert("", "end", values=(r["Serial"], r["Station"], r["Test"], r["Result"], r["Timestamp"], r["User"]))

    def update_dashboard_metrics(self, total_pass, total_fail, fpy_rate=None):
        """Calcula el rendimiento y restablece las alertas de color en las tarjetas superiores."""
        tot = total_pass + total_fail
        yd = round((total_pass / tot) * 100, 2) if tot > 0 else 0.0

        self.lbl_card_total_val.config(text=str(tot))
        self.lbl_card_pass_val.config(text=str(total_pass))
        self.lbl_card_fail_val.config(text=str(total_fail))
        self.lbl_card_yield_val.config(text=f"{yd}%\n(FPY: {fpy_rate}%)" if fpy_rate is not None else f"{yd}%", font=("Segoe UI", 16 if fpy_rate is not None else 24, "bold"))

        if tot == 0:
            self.card_yield.config(bg="#FFFFFF")
            self.lbl_card_yield_title.config(bg="#FFFFFF", fg="#1D1D1F")
            self.lbl_card_yield_val.config(bg="#FFFFFF", fg="#1D1D1F")
        elif yd >= 95.0:
            self.card_yield.config(bg="#EAF8EF")
            self.lbl_card_yield_title.config(bg="#EAF8EF", fg="#34C759")
            self.lbl_card_yield_val.config(bg="#EAF8EF", fg="#34C759")
        elif yd >= 85.0:
            self.card_yield.config(bg="#FFF4E5")
            self.lbl_card_yield_title.config(bg="#FFF4E5", fg="#FF9500")
            self.lbl_card_yield_val.config(bg="#FFF4E5", fg="#FF9500")
        else:
            self.card_yield.config(bg="#FDECEC")
            self.lbl_card_yield_title.config(bg="#FDECEC", fg="#FF3B30")
            self.lbl_card_yield_val.config(bg="#FDECEC", fg="#FF3B30")

    def refresh_chart(self, total_pass, total_fail):
        """Redibuja el gráfico horizontal de barras de distribución de resultados."""
        self.ax.clear()
        t = self.themes["light"]
        self.fig.patch.set_facecolor(t["surface"])
        self.ax.set_facecolor(t["surface_2"])
        bars = self.ax.barh(["Pass (OK)", "Fail (FAIL)"], [total_pass, total_fail], color=[t["success"], t["danger"]], height=0.55)
        self.ax.spines['top'].set_visible(False)
        self.ax.spines['right'].set_visible(False)
        self.ax.tick_params(colors=t["text"], labelsize=9)
        for b in bars:
            self.ax.text(b.get_width() + 0.1, b.get_y() + b.get_height() / 2, f'{int(b.get_width())}', va='center', fontweight='bold', color=t["text"])
        self.fig.tight_layout()
        self.canvas_plot.draw()

    def refresh_pareto_chart(self):
        """Redibuja el Diagrama de Pareto de Causa Raíz con curva acumulada."""
        self.ax_pareto_bars.clear()
        for ax in self.fig_pareto.get_axes():
            if ax is not self.ax_pareto_bars: ax.remove()
        t = self.themes["light"]
        self.fig_pareto.patch.set_facecolor(t["surface"])
        self.ax_pareto_bars.set_facecolor(t["surface_2"])
        if not self.top_failures:
            self.ax_pareto_bars.text(0.5, 0.5, "100% OK", ha='center', va='center', color=t["success"], fontweight='bold')
            self.ax_pareto_bars.axis('off')
            self.canvas_pareto.draw()
            return
        self.ax_pareto_bars.axis('on')
        # self.top_failures es una lista de tuplas (estacion, conteo) -> hay que
        # desempacar cada tupla en lugar de convertir la tupla completa.
        st = [str(x[0]) for x in self.top_failures[:7]]
        ct = [int(x[1]) for x in self.top_failures[:7]]
        self.ax_pareto_bars.bar(st, ct, color="#FF9500", width=0.45, edgecolor="#E68200")
        self.ax_pareto_bars.set_ylabel("Frecuencia (Fallas)", color="#E68200", fontweight="bold", fontsize=9)
        self.ax_pareto_bars.set_xticklabels(st, rotation=45, ha='right', fontsize=7, color=t["text"])

        tot = sum(x[1] for x in self.top_failures)
        ac, s = [], 0
        for x in self.top_failures[:len(st)]:
            s += x[1]
            ac.append((s / tot) * 100)
        ax2 = self.ax_pareto_bars.twinx()
        ax2.plot(st, ac, color="#007AFF", marker="o", linewidth=1.5, ms=4)
        ax2.set_ylabel("Porcentaje Acumulado", color="#007AFF", fontweight="bold", fontsize=9)
        ax2.set_ylim(0, 105)
        ax2.axhline(80, color=t["danger"], linestyle="--", linewidth=1.2, alpha=0.85)
        self.ax_pareto_bars.spines['top'].set_visible(False)
        ax2.spines['top'].set_visible(False)
        self.fig_pareto.tight_layout()
        self.canvas_pareto.draw()

    def export_to_pdf(self):
        """Genera un informe ejecutivo formal en formato PDF respetando el modo de vista activo."""
        if not self.filtered_records: return
        f = filedialog.asksaveasfilename(defaultextension=".pdf")
        if not f: return
        self.fig.savefig("t1.png", dpi=150)
        self.fig_pareto.savefig("t2.png", dpi=150)
        doc = SimpleDocTemplate(f, pagesize=letter)
        s = getSampleStyleSheet()
        story = [Paragraph("Reporte de Calidad NPI", s['Heading1']), Spacer(1, 15), Image("t1.png", width=440, height=160), Spacer(1, 15), Image("t2.png", width=440, height=160)]
        doc.build(story)
        for p in ["t1.png", "t2.png"]:
            if os.path.exists(p): os.remove(p)
        messagebox.showinfo("OK", "PDF OK")

