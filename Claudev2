    def start_async_load(self, is_automated=False):
        """Dispara la consulta en segundo plano liberando los filtros y botones en caliente."""
        if self.is_scanning: return
        self.is_scanning = True
        if not is_automated:
            self.btn_scan.config(state="disabled", text="Cargando...")
            self.progress.start(10)
        t = threading.Thread(target=self.load_data_thread, args=(is_automated,), daemon=True)
        t.start()

    def load_data_thread(self, is_automated):
        """Consulta remota con mapa de estaciones y desempaquetado posicional explícito."""
        estaciones_por_bu = {
            "SUR": ['MSRSFPREPARE', 'MSRSFPREPARE2', 'MSRSFFCT', 'MSRSFFCT2', 'MSRSFPROVISION', 'MSRSFREIMAGE', 'MSRSFREIMAGE2', 'MSRSFREIMAGE3', 'MSRSFROLLBACK', 'MSRSFROLLBACK2', 'MSRSFROLLBACK3'],
            "NFF": ['MSRSCPREPARE', 'MSRSCFT', 'MSRSCPROVISION', 'MSRSCREIMAGE', 'MSRSCREIMAGE2', 'MSRSCROLLBACK'],
            "IRR": ['MSRIRRPREPARE', 'MSRIRRPREPARE2', 'MSRIRRFCT', 'MSRIRRFCT2', 'MSRIRRFCT3', 'MSRIRRPROVISION', 'MSRIRRREIMAGE', 'MSRIRRREIMAGE2', 'MSRIRRREIMAGE3', 'MSRIRRROLLBACK', 'MSRIRRROLLBACK2', 'MSRIRRROLLBACK3']
        }
        bu_seleccionada = self.cmb_bu.get()
        lista_estaciones = estaciones_por_bu.get(bu_seleccionada, estaciones_por_bu["SUR"])
        fecha_ini = self.date_start.get_date().strftime('%Y-%m-%d')
        fecha_fin = self.date_end.get_date().strftime('%Y-%m-%d')
        mapped_records = []
        is_contingency = False
        execution_time = 0.0

        try:
            start_time = time.time()
            connection = oracledb.connect(
                user=self.db_config["user"], password=self.db_config["password"],
                host=self.db_config["host"], port=int(self.db_config["port"]), service_name=self.db_config["service_name"]
            )
            cursor = connection.cursor()
            placeholders = [f":est{i}" for i in range(len(lista_estaciones))]
            in_clause = ",".join(placeholders)

            query = f"""
                SELECT SERIAL_NR, CURR_STATUS, 'TEST', MEMO, TO_CHAR(CT_DATE, 'YYYY-MM-DD HH24:MI:SS'), 'Operator'
                FROM ERS.ERS_ITEM_TRACK
                WHERE CURR_STATUS IN ({in_clause})
                  AND TRUNC(CT_DATE) BETWEEN TO_DATE(:f_inicio, 'YYYY-MM-DD') AND TO_DATE(:f_fin, 'YYYY-MM-DD')
                ORDER BY CT_DATE ASC
            """
            parametros_query = {f"est{i}": est for i, est in enumerate(lista_estaciones)}
            parametros_query["f_inicio"] = fecha_ini
            parametros_query["f_fin"] = fecha_fin

            cursor.execute(query, parametros_query)
            raw_data = cursor.fetchall()
            execution_time = round(time.time() - start_time, 2)

            for row in raw_data:
                if not row or len(row) < 6: continue
                s_val = str(row[0]).strip() if row[0] is not None else ""
                st_val = str(row[1]).strip() if row[1] is not None else ""
                t_val = str(row[2]).strip() if row[2] is not None else "TEST"
                r_val = str(row[3]).strip() if row[3] is not None else "FAIL"
                ts_val = str(row[4]).strip() if row[4] is not None else ""
                u_val = str(row[5]).strip() if row[5] is not None else "Operator"

                mapped_records.append({
                    "Serial": s_val, "Station": st_val, "Test": t_val,
                    "Result": r_val, "Timestamp": ts_val, "User": u_val
                })
                try:
                    self.cursor_local.execute("""
                        INSERT OR IGNORE INTO server_logs (serial, station, test, result, datetime, operator, bu)
                        VALUES (?, ?, ?, ?, ?, ?, ?)
                    """, (s_val, st_val, t_val, r_val, ts_val, u_val, bu_seleccionada))
                except Exception: pass
            self.conn.commit()
            cursor.close()
            connection.close()
        except Exception as ex:
            # 🔍 DIAGNÓSTICO: imprime el error real de conexión/consulta en la
            # terminal en vez de tragárselo en silencio. Revisa la consola
            # después de correr la app para saber la causa exacta.
            import traceback
            print("=" * 70)
            print(f"[ORACLE] Falló la conexión/consulta, usando modo contingencia: {ex}")
            traceback.print_exc()
            print("=" * 70)
            is_contingency = True
            mapped_records = []
            try:
                placeholders = ",".join(["?"] * len(lista_estaciones))
                local_query = f"""
                    SELECT serial, station, test, result, datetime, operator FROM server_logs
                    WHERE bu = ? AND station IN ({placeholders}) AND SUBSTR(datetime, 1, 10) BETWEEN ? AND ?
                    ORDER BY datetime ASC
                """
                self.cursor_local.execute(local_query, [bu_seleccionada] + lista_estaciones + [fecha_ini, fecha_fin])
                for r in self.cursor_local.fetchall():
                    if not r or len(r) < 6: continue
                    mapped_records.append({
                        "Serial": str(r[0]).strip(), "Station": str(r[1]).strip(), "Test": str(r[2]).strip(),
                        "Result": str(r[3]).strip(), "Timestamp": str(r[4]).strip(), "User": str(r[5]).strip()
                    })
            except Exception: pass

        self.root.after(0, lambda: self.finalize_data_load(mapped_records, is_contingency, execution_time, is_automated))

    def finalize_data_load(self, mapped_records, is_contingency, execution_time, is_automated):
        self.is_scanning = False
        ld = self.lang_dict[self.current_lang]
        if not is_automated:
            self.progress.stop()
            self.btn_scan.config(state="normal", text=ld["scan"])
        self.records = mapped_records
        current_time_str = datetime.datetime.now().strftime("%H:%M:%S")
        if is_contingency:
            self.lbl_status_msg.config(text=f"{ld['status_contingency']}{current_time_str}", fg="#FF9500")
        else:
            self.lbl_status_msg.config(text=f"{ld['status_connected']}{current_time_str} | Response: {execution_time}s", fg="#6E6E73")
        self.filter_records()

    @staticmethod
    def _is_pass(result_value):
        """Determinación centralizada y consistente de si un resultado cuenta como Pass."""
        res = str(result_value).upper().strip()
        return res in ("OK", "PASS", "0", "APPROVED", "TRUE")

    def filter_records(self):
        """Filtra los registros adaptándose de forma flexible a los códigos puros de la planta."""
        search_txt = self.search_var.get().upper().strip()
        status_filter = self.cmb_status.get().strip()
        shift_filter = self.cmb_shift.get()
        view_mode_filter = self.cmb_view_mode.get()

        # Purgar las filas viejas del Treeview antes de recalcular
        for item in self.tree.get_children():
            self.tree.delete(item)

        self.filtered_records = []
        ld = self.lang_dict[self.current_lang]

        # Agrupar historial cronológico de números de serie
        history_by_serial = {}
        for row in self.records:
            sn = str(row["Serial"]).strip()
            if sn not in history_by_serial:
                history_by_serial[sn] = []
            history_by_serial[sn].append(row)

        for sn in history_by_serial:
            history_by_serial[sn].sort(key=lambda x: str(x["Timestamp"]))

        target_records = self.records
        if view_mode_filter in (ld["view_unique"], "Unidades Únicas (Último Estado)"):
            target_records = [rows[-1] for rows in history_by_serial.values()]

        # Bucle de segmentación y filtrado analítico por turno
        for row in target_records:
            try:
                time_part = str(row["Timestamp"]).split(" ")[1]
                h, m, s = map(int, time_part.split(":"))
                record_time = datetime.time(h, m, s)
            except Exception:
                record_time = datetime.time(0, 0, 0)

            match_shift = True
            if shift_filter in (ld["shift_1"], "1er Turno"):
                if not (datetime.time(6, 0, 0) <= record_time < datetime.time(15, 30, 0)):
                    match_shift = False
            elif shift_filter in (ld["shift_2"], "2do Turno"):
                if not (datetime.time(15, 30, 0) <= record_time < datetime.time(23, 54, 0)):
                    match_shift = False
            elif shift_filter in (ld["shift_3"], "3er Turno"):
                if not (record_time >= datetime.time(23, 54, 0) or record_time < datetime.time(6, 0, 0)):
                    match_shift = False

            is_pass = self._is_pass(row["Result"])

            match_status = True
            if status_filter in ("Pass", "OK") and not is_pass:
                match_status = False
            elif status_filter in ("Fail", "FAIL") and is_pass:
                match_status = False

            match_text = search_txt in str(row["Serial"]).upper() or search_txt in str(row["Station"]).upper()

            if match_shift and match_status and match_text:
                self.filtered_records.append(row)

        # Cómputo del indicador analítico FPY (First Pass Yield)
        fpy_rate = None
        if self.filtered_records:
            unique_serials = set(r["Serial"] for r in self.filtered_records)
            fpy_pass = 0
            for sn in unique_serials:
                full_history = history_by_serial.get(sn, [])
                if full_history:
                    if self._is_pass(full_history[0]["Result"]):
                        fpy_pass += 1
            fpy_rate = round((fpy_pass / len(unique_serials)) * 100, 2)

        # Extraer totales finales de producción del lote filtrado
        total_pass = sum(1 for r in self.filtered_records if self._is_pass(r["Result"]))
        total_fail = len(self.filtered_records) - total_pass

        self.update_dashboard_metrics(total_pass, total_fail, fpy_rate)
        self.refresh_chart(total_pass, total_fail)

        # Generar diccionario para el Diagrama de Pareto de Causa Raíz
        failure_counts = {}
        for r in self.filtered_records:
            if not self._is_pass(r["Result"]):
                st = str(r["Station"]).strip()
                failure_counts[st] = failure_counts.get(st, 0) + 1
        self.top_failures = sorted(failure_counts.items(), key=lambda x: x[1], reverse=True)
        self.refresh_pareto_chart()

        # Inyectar físicamente las filas limpias en el Treeview principal
        for row in self.filtered_records[:1000]:
            self.tree.insert("", "end", values=(
                str(row["Serial"]), str(row["Station"]), str(row["Test"]), str(row["Result"]), str(row["Timestamp"]), str(row["User"])
            ))

