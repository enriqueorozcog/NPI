                    tk.Label(rf, text=name, font=("Segoe UI", 8), bg=bg_c, fg=fg_s, width=14, anchor="w").pack(side="left", padx=(10, 0))
                    tk.Label(rf, text=str(inp_v), font=("Segoe UI", 8), bg=bg_c, width=5).pack(side="left")
