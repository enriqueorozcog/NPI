                tk.Label(header_day, text=date_str, font=("Segoe UI", 10, "bold"), bg="#2E2E3A", fg="#FFFFFF").pack(side="left", padx=10, pady=5)

                sub_header = tk.Frame(day_card, bg=t["surface_2"], height=24)
                sub_header.pack(fill="x", side="top")
                tk.Label(sub_header, text="Station", font=("Segoe UI", 8, "bold"), bg=t["surface_2"], width=14, anchor="w").pack(side="left", padx=(10, 0))
                tk.Label(sub_header, text="Input", font=("Segoe UI", 8, "bold"), bg=t["surface_2"], width=5).pack(side="left")
                tk.Label(sub_header, text="Failed", font=("Segoe UI", 8, "bold"), bg=t["surface_2"], width=5).pack(side="left")
