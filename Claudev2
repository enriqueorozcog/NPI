                "IRR": ['MSRIRRPREPARE', 'MSRIRRPREPARE2', 'MSRIRRFCT', 'MSRIRRFCT2', 'MSRIRRFCT3', 'MSRIRRPROVISION', 'MSRIRRREIMAGE', 'MSRIRRREIMAGE2', 'MSRIRRREIMAGE3', 'MSRIRRROLLBACK', 'MSRIRRROLLBACK2', 'MSRIRRROLLBACK3']
            }.get(bu_sel, [])

            daily_map = {}
            try:
                placeholders = ",".join(["?"] * len(estaciones))
                query_local = f"SELECT datetime, station, result FROM server_logs WHERE bu=? AND station IN ({placeholders}) AND SUBSTR(datetime,1,10) BETWEEN ? AND ?"
                self.cursor_local.execute(query_local, [bu_sel] + estaciones + [f_ini, f_fin])
                db_rows = self.cursor_local.fetchall()

                for r in db_rows:
                    if not r or len(r) < 3: continue
                    dt_str = str(r[0]).strip() if r[0] is not None else ""
                    st_str = str(r[1]).strip() if r[1] is not None else "UNKNOWN"
                    res_str = str(r[2]).strip().upper() if r[2] is not None else "FAIL"

                    if " " not in dt_str: continue
                    time_parts = dt_str.split(" ")
                    date_key = time_parts[0]
                    hora_raw = time_parts[1]

                    try:
                        h, m, s = map(int, hora_raw.split(":"))
                        rec_time = datetime.time(h, m, s)
                    except Exception:
                        rec_time = datetime.time(0, 0, 0)

                    m_s = True
                    if shift_sel in (ld["shift_1"], "1er Turno"):
                        if not (datetime.time(6, 0, 0) <= rec_time < datetime.time(15, 30, 0)): m_s = False
                    elif shift_sel in (ld["shift_2"], "2do Turno"):
                        if not (datetime.time(15, 30, 0) <= rec_time < datetime.time(23, 54, 0)): m_s = False
                    elif shift_sel in (ld["shift_3"], "3er Turno"):
                        if not (rec_time >= datetime.time(23, 54, 0) or rec_time < datetime.time(6, 0, 0)): m_s = False

                    is_p = self._is_pass(res_str)
                    m_st = True
                    if status_sel in ("Pass", "OK") and not is_p: m_st = False
                    elif status_sel in ("Fail", "FAIL") and is_p: m_st = False

                    if m_s and m_st:
                        if date_key not in daily_map:
                            daily_map[date_key] = {}
                        if st_str not in daily_map[date_key]:
                            daily_map[date_key][st_str] = {"input": 0, "failed": 0, "pass": 0}

                        daily_map[date_key][st_str]["input"] += 1
                        if is_p: daily_map[date_key][st_str]["pass"] += 1
                        else: daily_map[date_key][st_str]["failed"] += 1
            except Exception as ex:
