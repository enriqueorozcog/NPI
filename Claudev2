                rows_scroll_frame = tk.Frame(day_card, bg=t["surface"])
                rows_scroll_frame.pack(fill="both", expand=True)

                s_list = []
                for st, m in daily_map[date_str].items():
                    inp, f = m["input"], m["failed"]
                    pct = round((m["pass"] / inp) * 100, 2) if inp > 0 else 0.0
                    s_list.append((st, inp, f, pct))
                s_list.sort(key=lambda x: x[3])  # Peores estaciones (menor Pass %) arriba

                for name, inp_v, f_cnt, pass_p in s_list:
                    rf = tk.Frame(rows_scroll_frame, height=26, pady=1)
                    rf.pack(fill="x")
                    rf.pack_propagate(False)
