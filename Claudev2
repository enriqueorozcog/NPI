def check_and_create_config():
    """Carga la configuración de conexión a Oracle.

    SEGURIDAD: host/puerto/service_name no son secretos y se guardan en
    config.ini para conveniencia. El usuario y la contraseña de Oracle NUNCA
    se escriben en disco: se leen exclusivamente de las variables de entorno
    NPI_DB_USER y NPI_DB_PASSWORD, que cada quien configura en su propia
    máquina. Así, aunque config.ini se comparta o se suba por error a un
    repositorio, las credenciales reales no quedan expuestas.

    Cómo configurarlas (Windows, PowerShell), de forma permanente:
        setx NPI_DB_USER "PMXERS_RPT"
        setx NPI_DB_PASSWORD "tu_password_aqui"
      (cierra y vuelve a abrir la terminal/IDE para que tomen efecto)

    Cómo configurarlas (Windows, CMD), solo para la sesión actual:
        set NPI_DB_USER=PMXERS_RPT
        set NPI_DB_PASSWORD=tu_password_aqui

    Cómo configurarlas (Linux/Mac, bash/zsh):
        export NPI_DB_USER="PMXERS_RPT"
        export NPI_DB_PASSWORD="tu_password_aqui"
    """
    config_file = "config.ini"
    config = configparser.ConfigParser()
    if not os.path.exists(config_file):
        config["DATABASE"] = {
            "host": "10.235.5.11",
            "port": "1521",
            "service_name": "pmxesdb1",
        }
        with open(config_file, "w") as configfile:
            config.write(configfile)
    config.read(config_file)
    db_config = dict(config["DATABASE"])

    db_user = os.environ.get("NPI_DB_USER")
    db_password = os.environ.get("NPI_DB_PASSWORD")

    if not db_user or not db_password:
        messagebox.showerror(
            "Configuración faltante",
            "No se encontraron las variables de entorno NPI_DB_USER y/o "
            "NPI_DB_PASSWORD.\n\nDefínelas antes de iniciar la aplicación "
            "(ver instrucciones en el docstring de check_and_create_config) "
            "y vuelve a intentarlo."
        )
        sys.exit(1)

    db_config["user"] = db_user
    db_config["password"] = db_password
    return db_config


class LogParserEngine:
    """Motor analítico para parseo de logs con JSON embebido (Compatibilidad Local)."""
    @staticmethod
    def parse_file(file_path):
        serial, model, test = None, None, None
        result, dt = "Fail", None
        ts_re = re.compile(r"^\[(?P<dt>\d{4}-\d{2}-\d{2})T(?P<t>\d{2}:\d{2}:\d{2})")
        js_re = re.compile(r"-\s+(\{.*ProductName.*SerialNumber.*\})")
        try:
            with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
                f.seek(0)
                for line in f:
                    if not dt:
                        ts_m = ts_re.match(line)
                        if ts_m: dt = f"{ts_m.group('dt')} {ts_m.group('t')}"
                    js_m = js_re.search(line)
                    if js_m:
                        try:
                            d = json.loads(js_m.group(1))
                            serial = d.get("SerialNumber") or d.get("SystemDutSn")
                            model = d.get("ProductName") or d.get("Project")
                        except Exception: pass
            if "Starting CrewReprovision..." in content or "Starting CrewDevicePrep..." in content:
                if "Success" in content: result = "Pass"
        except Exception: pass
        return serial, model, test, result, dt


