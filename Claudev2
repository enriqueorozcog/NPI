    def toggle_lang(self):
        self.current_lang = "ENG" if self.current_lang == "ESP" else "ESP"
        self.update_ui_text()

    def toggle_live_mode(self):
        self.live_mode = not self.live_mode
        self.btn_live.config(text=self.lang_dict[self.current_lang]["live_on"] if self.live_mode else self.lang_dict[self.current_lang]["live_off"])

    def run_live_loop(self):
        if self.live_mode and not self.is_scanning: self.start_async_load(is_automated=True)
        self.root.after(30000, self.run_live_loop)


