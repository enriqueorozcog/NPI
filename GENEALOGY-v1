    # =====================================================================
    # LÓGICA DE CONEXIÓN A BASE DE DATOS Y API
    # =====================================================================
    def obtener_token_oracle(self):
        """Extrae el token activo desde tu base de datos Oracle (Modo Thin)"""
        usuario = "PMXERS_RPT"
        contrasena = "rptPMX$2310"
        dsn_string = "(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=10.235.5.11)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=pmxesdb1)))"
        
        query = "SELECT TOKEN FROM ers_edi_kore_token WHERE active_flag = 'Y'"
        
        try:
            connection = oracledb.connect(user=usuario, password=contrasena, dsn=dsn_string)
            with connection.cursor() as cursor:
                cursor.execute(query)
                row = cursor.fetchone()
                if row:
                    return row[0] # Extrae el string del Token JWT
            return None
        except Exception as e:
            print(f"Error base de datos: {e}")
            return None

    def ejecutar_consulta(self):
        """Se activa al dar clic en 'Consultar'"""
        sn_ingresado = self.entry_sn.get().strip()
        
        if not sn_ingresado:
            messagebox.showwarning("Campo vacío", "Por favor introduce un Número de Serie válido.")
            return
            
        # 1. Validar u obtener token de Oracle
        if not self.token_actual:
            self.btn_consultar.configure(text="Conectando BD...")
            self.update()
            self.token_actual = self.obtener_token_oracle()
            
        if not self.token_actual:
            self.btn_consultar.configure(text="Consultar")
            messagebox.showerror("Error de Autenticación", "No se pudo extraer el token activo desde Oracle.\nVerifica tus datos de red.")
            return
            
        # 2. Consultar API de Microsoft
        self.btn_consultar.configure(text="Buscando API...")
        self.update()
        
        url = f"https://api.supplychain.microsoft.com/Manufacturing/GenealogyService/V2/Devices/{sn_ingresado}"
        headers = {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "SiteIdentifier": "0001004439",
            "Authorization": f"Bearer {self.token_actual}"
        }
        
        try:
            response = requests.get(url, headers=headers)
            self.btn_consultar.configure(text="Consultar")
            
            if response.status_code == 200:
                data = response.json()
                
                # Extraer información básica
                sn = data.get('DeviceSerialNumber', 'N/A')
                project = data.get('Project', 'N/A')
                product = data.get('Product', 'N/A')
                process = data.get('ProcessName', 'N/A')
                lifecycle = data.get('ProductLifecycle', 'N/A')
                event_time = data.get('DeviceEventTime', 'N/A')
                
                # Extraer atributos del assembly FINALASSEMBLY
                attributes = {}
                assemblies = data.get('AssemblyCollection', [])
                for assembly in assemblies:
                    if assembly.get('AssemblyKey') == 'FINALASSEMBLY':
                        attrs = assembly.get('Attributes', [])
                        for attr in attrs:
                            attributes[attr.get('AttributeName')] = attr.get('AttributeValue')
                
                # Extraer información de componentes
                motherboard_sn = ''
                battery_sn = ''
                display_sn = ''
                storage_model = ''
                
                for assembly in assemblies:
                    components = assembly.get('Components', [])
                    for comp in components:
                        location = comp.get('ComponentLocation', '')
                        if location == 'MOTHERBOARD':
                            motherboard_sn = comp.get('ComponentSerialNumber', 'N/A')
                        elif location == 'BATTERY':
                            battery_sn = comp.get('ComponentSerialNumber', 'N/A')
                        elif location == 'DISPLAYPANEL':
                            display_sn = comp.get('ComponentSerialNumber', 'N/A')
                        elif location == 'BUCKET':
                            storage_model = comp.get('ComponentVendorName', 'N/A')
                
                # Actualizar Tarjeta 1: Detalles del Dispositivo
                self.lbl_sn.configure(text=f"Serial Number: {sn}")
                self.lbl_proyecto.configure(text=f"Proyecto: {project}")
                self.lbl_producto.configure(text=f"Producto: {product}")
                self.lbl_modelo.configure(text=f"Modelo: {attributes.get('MODEL', 'N/A')}")
                self.lbl_lifecycle.configure(text=f"Lifecycle: {lifecycle}")
                
                # Actualizar Tarjeta 2: Especificaciones Técnicas
                self.lbl_ram.configure(text=f"RAM: {attributes.get('RAMSIZE', 'N/A')}")
                self.lbl_storage.configure(text=f"Almacenamiento: {attributes.get('STORAGESPACE', 'N/A')}")
                self.lbl_cpu.configure(text=f"CPU: {attributes.get('CPUTYPE', 'N/A')}")
                os_version = attributes.get('OSVERSHORT', 'N/A')
                self.lbl_os.configure(text=f"OS: Windows 11 ({os_version})")
                self.lbl_country.configure(text=f"País de Origen: {attributes.get('COUNTRYOFORIGIN', 'N/A')}")
                
                # Actualizar Tarjeta 3: Estado y Seguimiento
                self.lbl_proceso.configure(text=f"Proceso Actual: {process}")
                event_date = event_time.split('T')[0] if 'T' in event_time else event_time
                self.lbl_fecha.configure(text=f"Fecha del Evento: {event_date}")
                self.lbl_firmware.configure(text=f"Firmware: {attributes.get('FIRMWAREVERSION', 'N/A')}")
                
                # Actualizar Badge según proceso
                proceso = process.upper()
                if "REFURBISHMENT" in proceso:
                    self.lbl_badge.configure(text=" REACONDICIONAMIENTO ", fg_color="#3B82F6", text_color="white")
                else:
                    self.lbl_badge.configure(text=f" {proceso} ", fg_color="#10B981", text_color="white")
                
                # Actualizar Tarjeta 4: Componentes Principales
                self.lbl_motherboard.configure(text=f"Motherboard: {motherboard_sn}")
                self.lbl_battery.configure(text=f"Batería: {battery_sn}")
                self.lbl_display.configure(text=f"Display: {display_sn}")
                self.lbl_storage_model.configure(text=f"Storage: {storage_model}")
                
                # Actualizar Tarjeta 5: Atributos del Dispositivo
                # Limpiar atributos anteriores
                for widget in self.attributes_scroll.winfo_children():
                    widget.destroy()
                self.attribute_labels.clear()
                
                # Atributos a mostrar
                atributos_mostrar = {
                    'WIFIMACADDRESS': 'WiFi MAC Address',
                    'BLUETOOTHMACADDRESS': 'Bluetooth MAC Address',
                    'UUID': 'UUID',
                    'OA3KEY': 'OA3 Key',
                    'YEAROFMFG': 'Año Manufactura',
                    'ISDOA': 'Es DOA',
                    'ISRNR': 'RNR Status',
                    'ISFRU': 'Es FRU',
                    'STORAGEMODEL': 'Storage Model',
                    'STORAGEFWVERSION': 'Storage FW Version',
                    'IMPROVRELEASEVERSION': 'IMPROV Release',
                    'DUTTYPE': 'DUT Type',
                    'DEVICECOLOR': 'Color del Dispositivo',
                    'REGIONALIZEDDEVICEPARTNUMBER': 'Part Number Reg.',
                    'SOFTWAREASSEMBLYPARTNUMBER': 'Software Part Number',
                    'PASSTHROUGHLANADDRESS': 'LAN Address',
                    'COMPUTEMBSN': 'Compute MB SN',
                    'SYSTEMDUTSN': 'System DUT SN'
                }
                
                # Crear labels para cada atributo
                row = 0
                col = 0
                for attr_key, attr_label in atributos_mostrar.items():
                    attr_value = attributes.get(attr_key, 'N/A')
                    lbl = ctk.CTkLabel(self.attributes_scroll, text=f"{attr_label}: {attr_value}", font=ctk.CTkFont(size=11), justify="left")
                    lbl.grid(row=row, column=col, sticky="ew", padx=10, pady=3)
                    
                    col += 1
                    if col >= 4:
                        col = 0
                        row += 1
                    
            elif response.status_code == 401:
                # Si el token expiró mientras la app estaba abierta, lo borramos para pedir uno nuevo el próximo clic
                self.token_actual = None
                messagebox.showerror("Token Expirado", "El token ha caducado. Intenta dar clic en Consultar nuevamente para refrescarlo.")
            else:
                messagebox.showerror("Error API", f"Dispositivo no encontrado o error de parámetros.\nCódigo HTTP: {response.status_code}")
                
        except Exception as e:
            self.btn_consultar.configure(text="Consultar")
            messagebox.showerror("Error de Red", f"No se pudo establecer comunicación con el servidor de Microsoft:\n{e}")

