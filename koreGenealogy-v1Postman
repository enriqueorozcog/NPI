    def limpiar_vista(self, view):
        for widget in view.winfo_children():
            widget.destroy()

    def agregar_encabezado_tabla(self, parent, headers, column_weights=None):
        for column, header in enumerate(headers):
            parent.grid_columnconfigure(column, weight=(column_weights or {}).get(column, 1), uniform="table")
            ctk.CTkLabel(
                parent,
                text=header,
                font=ctk.CTkFont(size=11, weight="bold"),
                text_color="#9B9BA6",
                anchor="w"
            ).grid(row=0, column=column, sticky="ew", padx=10, pady=(8, 5))

    def agregar_fila_tabla(self, parent, row, values, value_columns=None, text_color=None, hover=False, column_weights=None):
        value_columns = value_columns or set()
        row_frame = ctk.CTkFrame(parent, fg_color="transparent", corner_radius=3)
        row_frame.grid(row=row, column=0, columnspan=len(values), sticky="ew", padx=2, pady=1)
        for column in range(len(values)):
            row_frame.grid_columnconfigure(
                column,
                weight=(column_weights or {}).get(column, 1),
                uniform="table-row"
            )
        for column, value in enumerate(values):
            value_label = ctk.CTkLabel(
                row_frame,
                text=str(value),
                font=ctk.CTkFont(size=11, weight="bold" if column in value_columns else "normal"),
                text_color=text_color,
                anchor="w",
                justify="left"
            )
            value_label.grid(row=0, column=column, sticky="ew", padx=8, pady=4)
            if hover:
                value_label.bind("<Enter>", lambda _event, target=row_frame: target.configure(fg_color="#303039"))
                value_label.bind("<Leave>", lambda _event, target=row_frame: target.configure(fg_color="transparent"))

        if hover:
            row_frame.bind("<Enter>", lambda _event, target=row_frame: target.configure(fg_color="#303039"))
            row_frame.bind("<Leave>", lambda _event, target=row_frame: target.configure(fg_color="transparent"))

    def crear_detalle_assembly(self, parent, assembly):
        components = assembly.get("Components") or []
        attributes = assembly.get("Attributes") or []
        esns = assembly.get("Esns") or []

        ctk.CTkLabel(
            parent,
            text=f"Components ({len(components)})",
            font=ctk.CTkFont(size=11, weight="bold"),
            text_color="#A7A7B3",
            anchor="w"
        ).pack(fill="x", padx=12, pady=(10, 4))
        component_table = ctk.CTkFrame(parent, fg_color="transparent")
        component_table.pack(fill="x", padx=8)
        self.agregar_encabezado_tabla(
            component_table,
            ("Location", "Part #", "Serial", "Vendor", "State"),
            {0: 2, 1: 2, 2: 3, 3: 2, 4: 1}
        )
        for row, component in enumerate(components, start=1):
            serial = component.get("ComponentSerialNumber") or component.get("ComponentLotTrackingNumber") or "N/A"
            self.agregar_fila_tabla(component_table, row, (
                component.get("ComponentLocation") or "N/A",
                component.get("ComponentPartNumber") or "N/A",
                serial,
                component.get("ComponentVendorName") or "N/A",
                component.get("ComponentReuseState") or "N/A"
            ), {4}, "#E5E7EB", True, {0: 2, 1: 2, 2: 3, 3: 2, 4: 1})

        ctk.CTkLabel(
            parent,
            text=f"Key Attributes ({len(attributes)})",
            font=ctk.CTkFont(size=11, weight="bold"),
            text_color="#A7A7B3",
            anchor="w"
        ).pack(fill="x", padx=12, pady=(12, 4))
        attribute_table = ctk.CTkFrame(parent, fg_color="transparent")
        attribute_table.pack(fill="x", padx=8)
        self.agregar_encabezado_tabla(attribute_table, ("Attribute", "Value"), {0: 2, 1: 3})
        for row, attribute in enumerate(attributes, start=1):
            self.agregar_fila_tabla(attribute_table, row, (
                attribute.get("AttributeName") or "N/A",
                attribute.get("AttributeValue") or "N/A"
            ), {1}, "#E5E7EB", True, {0: 2, 1: 3})

        ctk.CTkLabel(
            parent,
            text=f"ESNs / MACs ({len(esns)})",
            font=ctk.CTkFont(size=11, weight="bold"),
            text_color="#A7A7B3",
            anchor="w"
        ).pack(fill="x", padx=12, pady=(12, 4))
        esn_table = ctk.CTkFrame(parent, fg_color="transparent")
        esn_table.pack(fill="x", padx=8, pady=(0, 10))
        self.agregar_encabezado_tabla(esn_table, ("Name", "Value"), {0: 2, 1: 3})
        for row, esn in enumerate(esns, start=1):
            self.agregar_fila_tabla(esn_table, row, (
                esn.get("EsnName") or "N/A",
                esn.get("EsnValue") or "N/A"
            ), {1}, "#E5E7EB", True, {0: 2, 1: 3})

    def alternar_assembly(self, detail_frame, arrow_button, expanded):
        if expanded:
            detail_frame.pack_forget()
            arrow_button.configure(text=">")
        else:
            detail_frame.pack(fill="x", padx=8, pady=(0, 8))
            arrow_button.configure(text="v")
        return not expanded

    def filtrar_componentes(self, _event=None):
        search = self.components_search.get().strip().lower()
        filtered = [
            component for component in self.all_components
            if not search or search in " ".join(str(value or "") for value in (
                component.get("ComponentLocation"),
                component.get("ComponentPartNumber"),
                component.get("ComponentSerialNumber"),
                component.get("ComponentLotTrackingNumber"),
                component.get("ComponentVendorName"),
                component.get("ComponentReuseState"),
                component.get("DOA")
            )).lower()
        ]
        self.limpiar_vista(self.components_view)
        self.agregar_encabezado_tabla(
            self.components_view,
            ("Location", "Part #", "Serial / Lot", "Vendor", "State", "DOA"),
            {0: 2, 1: 2, 2: 3, 3: 2, 4: 1, 5: 1}
        )
        for row, component in enumerate(filtered, start=1):
            serial_or_lot = component.get("ComponentSerialNumber") or component.get("ComponentLotTrackingNumber") or "N/A"
            self.agregar_fila_tabla(self.components_view, row, (
                component.get("ComponentLocation") or "N/A",
                component.get("ComponentPartNumber") or "N/A",
                serial_or_lot,
                component.get("ComponentVendorName") or "N/A",
                component.get("ComponentReuseState") or "N/A",
                component.get("DOA") or "No"
            ), {4}, "#E5E7EB", True, {0: 2, 1: 2, 2: 3, 3: 2, 4: 1, 5: 1})
        self.components_count_label.configure(text=f"{len(filtered)} of {len(self.all_components)} components")

    def filtrar_atributos(self, _event=None):
        search = self.attributes_search.get().strip().lower()
        filtered = [
            (key, value) for key, value in self.all_attributes.items()
            if not search or search in f"{key} {value}".lower()
        ]
        self.limpiar_vista(self.attributes_view)
        self.agregar_encabezado_tabla(self.attributes_view, ("Attribute", "Value"), {0: 2, 1: 3})
        for row, (key, value) in enumerate(sorted(filtered), start=1):
            self.agregar_fila_tabla(
                self.attributes_view,
                row,
                (key, value),
                {1},
                "#E5E7EB",
                True,
                {0: 2, 1: 3}
            )
        self.attributes_count_label.configure(text=f"{len(filtered)} of {len(self.all_attributes)} attributes")

    def mostrar_datos_dashboard(self, data, assemblies, attributes):
        self.summary_fields["SERIAL NUMBER"].configure(text=data.get("DeviceSerialNumber") or "N/A")
        process = data.get("ProcessName") or "N/A"
        process_label = self.summary_fields["PROCESS"]
        process_name = str(process).strip().upper()
        if process_name == "REPAIR":
            process_label.configure(
                text="REPAIR",
                fg_color="#FFF0D6",
                text_color="#D97706",
                corner_radius=10
            )
        elif process_name == "REFURBISHMENT":
            process_label.configure(
                text="REFURBISHMENT",
                fg_color="#DCFCE7",
                text_color="#15803D",
                corner_radius=10
            )
        else:
            process_label.configure(
                text=process,
                fg_color="transparent",
                text_color=("#1F2937", "#F3F4F6"),
                corner_radius=0
            )
        product = data.get("Product") or "N/A"
        project = data.get("Project") or "N/A"
        self.summary_fields["PRODUCT / PROJECT"].configure(text=f"{product} / {project}")
        self.summary_fields["LIFECYCLE"].configure(text=data.get("ProductLifecycle") or "N/A")
