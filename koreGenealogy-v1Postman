    def obtener_credenciales_oracle(self):
        usuario = os.getenv("KORE_ORACLE_USER") or keyring.get_password(self.CREDENTIAL_SERVICE, "username")
        contrasena = os.getenv("KORE_ORACLE_PASSWORD") or keyring.get_password(self.CREDENTIAL_SERVICE, usuario or "username")

        if not usuario:
            usuario = simpledialog.askstring("Configuración de Oracle", "Usuario de Oracle:", parent=self)
        if usuario and not contrasena:
            contrasena = simpledialog.askstring("Configuración de Oracle", "Contraseña de Oracle:", show="*", parent=self)
            if contrasena:
                keyring.set_password(self.CREDENTIAL_SERVICE, "username", usuario)
                keyring.set_password(self.CREDENTIAL_SERVICE, usuario, contrasena)
        return usuario, contrasena

    def obtener_token_oracle(self, usuario, contrasena):
        """Se extrae el token activo desde la base de datos Oracle (Modo Thin)"""
        host = os.getenv("KORE_ORACLE_HOST", "10.235.5.11")
        port = os.getenv("KORE_ORACLE_PORT", "1521")
        service_name = os.getenv("KORE_ORACLE_SERVICE", "pmxesdb1")

        if not usuario or not contrasena:
            self.error_oracle = "Faltan KORE_ORACLE_USER o KORE_ORACLE_PASSWORD en este proceso."
            print(self.error_oracle)
            return None

        dsn_string = oracledb.makedsn(host, port, service_name=service_name)
        
        query = "SELECT TOKEN FROM ers_edi_kore_token WHERE active_flag = 'Y'"
        
        try:
            with oracledb.connect(user=usuario, password=contrasena, dsn=dsn_string) as connection:
                with connection.cursor() as cursor:
                    cursor.execute(query)
                    row = cursor.fetchone()
                    if row:
                        return row[0]
            self.error_oracle = "La consulta no devolvió ningún token activo."
            return None
        except Exception as e:
            self.error_oracle = f"{type(e).__name__}: {e}"
            print(f"Error base de datos: {self.error_oracle}")
            return None

    def ejecutar_consulta(self):
        """Se activa al dar clic en 'Consultar'"""
        sn_ingresado = self.entry_sn.get().strip()
        
        if not sn_ingresado:
            messagebox.showwarning("Campo vacío", "Por favor introduce un Número de Serie válido.")
            return
            
        usuario = contrasena = None
        if not self.token_actual:
            usuario, contrasena = self.obtener_credenciales_oracle()
            if not usuario or not contrasena:
                messagebox.showerror("Error de Autenticación", "Faltan las credenciales de Oracle.")
                return

        self.btn_consultar.configure(state="disabled", text="Consultando...")
        self.progress_bar.start()

        def _consulta_worker(sn):
            url = f"https://api.supplychain.microsoft.com/Manufacturing/GenealogyService/V2/Devices/{sn}"
            headers = {
                "Content-Type": "application/json",
                "Accept": "application/json",
                "SiteIdentifier": "0001004439",
                "Authorization": f"Bearer {self.token_actual}"
            }
            try:
                token = self.token_actual
                if not token:
                    token = self.obtener_token_oracle(usuario, contrasena)
                if not token:
                    self.after(10, lambda: self._consulta_error(
                        "Error de Autenticación",
                        "No se pudo extraer el token activo desde Oracle.\n\n"
                        f"Diagnóstico: {self.error_oracle or 'Causa desconocida'}"
                    ))
                    return
                self.token_actual = token
                resp = requests.get(url, headers={**headers, "Authorization": f"Bearer {token}"}, timeout=30)
            except Exception as e:
                # Network error: re-enable button and show message on main thread
                def _err():
                    self._consulta_error("Error de Red", f"No se pudo establecer comunicación con el servidor:\n{e}")
                self.after(10, _err)
                return

            def _handle_response():
                self._finalizar_consulta()
                if resp.status_code == 200:
                    try:
                        data = resp.json()
                    except Exception:
                        messagebox.showerror("Error API", "Respuesta inválida JSON desde la API.")
                        return

                    # Collect attributes and assemblies safely
                    assemblies = data.get('AssemblyCollection') or []
                    attributes = {}
                    for assembly in assemblies:
                        if assembly.get('AssemblyKey') == 'FINALASSEMBLY':
                            for attr in assembly.get('Attributes') or []:
                                k = attr.get('AttributeName')
                                if k:
                                    attributes[k] = attr.get('AttributeValue') or 'N/A'

                    self.mostrar_datos_dashboard(data, assemblies, attributes)
                elif resp.status_code == 401:
                    self.token_actual = None
                    messagebox.showerror("Token Expirado", "El token ha caducado. Intenta dar clic en Consultar nuevamente para refrescarlo.")
                else:
                    messagebox.showerror("Error API", f"Dispositivo no encontrado o error de parámetros.\nCódigo HTTP: {resp.status_code}")

            # Schedule handling on main thread
            self.after(10, _handle_response)

        thread = threading.Thread(target=_consulta_worker, args=(sn_ingresado,), daemon=True)
        thread.start()

    def _finalizar_consulta(self):
        self.progress_bar.stop()
        self.progress_bar.set(0)
        self.btn_consultar.configure(state="normal", text="Consultar")

    def _consulta_error(self, title, message):
        self._finalizar_consulta()
        messagebox.showerror(title, message)
            

