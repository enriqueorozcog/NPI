    def crear_campo(self, parent, key, value, pady=(3, 3)):
        field_frame = ctk.CTkFrame(parent, fg_color="transparent")
        field_frame.pack(fill="x", pady=pady, padx=15)

        key_label = ctk.CTkLabel(field_frame, text=key, font=ctk.CTkFont(size=13), justify="left")
        key_label.pack(side="left", anchor="w", padx=(0, 4))

        value_label = ctk.CTkLabel(field_frame, text=value, font=ctk.CTkFont(size=13, weight="bold"), justify="left")
        value_label.pack(side="left", anchor="w")

        return key_label, value_label
        
