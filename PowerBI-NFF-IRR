    def toggle_lang(self):
        self.current_lang = "ENG" if self.current_lang == "ESP" else "ESP"
        self.btn_lang.config(text=self.current_lang)
        self.update_ui_text()

    def toggle_theme(self):
        self.dark_mode = not self.dark_mode
        self.btn_theme.config(text="☀️" if self.dark_mode else "🌙")
        self.apply_theme()

    def toggle_live_mode(self):
        self.live_mode = not self.live_mode
        ld = self.lang_dict[self.current_lang]
        self.btn_live.config(text=ld["live_on"] if self.live_mode else ld["live_off"])

    def run_live_loop(self):
        if self.live_mode: self.load_data()
        self.root.after(5000, self.run_live_loop)

