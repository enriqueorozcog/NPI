    def load_data(self):
        """Conexión nativa a Oracle filtrando dinámicamente por Unidad de Negocio."""
        for row in self.tree.get_children():
            self.tree.delete(row)
            
        self.records = [] 

        # Diccionario con la matriz de estaciones solicitadas por Unidad de Negocio
        estaciones_por_bu = {
            "SUR": ['MSRSFPREPARE', 'MSRSFPREPARE2', 'MSRSFFCT', 'MSRSFFCT2', 'MSRSFPROVISION'],
            "NFF": ['MSRSCPREPARE', 'MSRSCFT', 'MSRSCPROVISION'],
            "IRR": ['MSRIRRPREPARE', 'MSRIRRPREPARE2', 'MSRIRRFCT', 'MSRIRRFCT2', 'MSRIRRFCT3', 'MSRIRRPROVISION']
        }

        # Captura la unidad de negocio activa elegida en el Combobox
        bu_seleccionada = self.cmb_bu.get()
        lista_estaciones = estaciones_por_bu.get(bu_seleccionada, estaciones_por_bu["SUR"])

        try:
            # Conexión nativa de alto rendimiento
            connection = oracledb.connect(
                user="PMXERS_RPT",
                password="rptPMX$2310",
                host="10.235.5.11",
                port=1521,
                service_name="pmxesdb1"
            )
            cursor = connection.cursor()

            # Captura de fecha desde los componentes del calendario
            fecha_busqueda = self.date_start.get_date().strftime('%Y-%m-%d')
            
            # Construcción segura de marcadores de posición dinámicos para la cláusula IN (:est0, :est1...)
            placeholders = [f":est{i}" for i in range(len(lista_estaciones))]
            in_clause = ",".join(placeholders)

            query = f"""
                SELECT 
                    SERIAL_NR AS "Serial",
                    CURR_STATUS AS "Station",
                    'TEST' AS "Test",
                    MEMO AS "Result",
                    TO_CHAR(CT_DATE, 'YYYY-MM-DD HH24:MI:SS') AS "Timestamp",
                    'Operator' AS "User"
                FROM ERS.ERS_ITEM_TRACK
                WHERE CURR_STATUS IN ({in_clause})
                  AND TRUNC(CT_DATE) = TO_DATE(:fecha, 'YYYY-MM-DD')
                ORDER BY CT_DATE ASC
            """
            
            # Integración de parámetros dinámicos en el diccionario
            parametros_query = {f"est{i}": est for i, est in enumerate(lista_estaciones)}
            parametros_query["fecha"] = fecha_busqueda

            cursor.execute(query, parametros_query)
            self.records = cursor.fetchall()

            total_pass = 0
            total_fail = 0

            # Inserción de datos reales en la cuadrícula de Tkinter
            for row in self.records:
                self.tree.insert("", "end", values=row)
                
                # Conteo basado en la columna MEMO (Índice 3 del SELECT)
                if row[3] == "OK":
                    total_pass += 1
                elif row[3] == "FAIL":
                    total_fail += 1

            cursor.close()
            connection.close()

            # Refrescar componentes analíticos e indicadores de la UI
            self.update_dashboard_metrics(total_pass, total_fail)
            self.refresh_chart(total_pass, total_fail)

        except Exception as e:
            messagebox.showerror("Database Error", f"Fallo al conectar con Oracle: {e}")


