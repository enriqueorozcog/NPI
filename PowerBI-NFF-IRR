    def export_to_csv(self):
        """Exporta el set de datos cargado en la UI a un archivo CSV estructurado."""
        if not self.records:
            messagebox.showwarning("Exportar", "No existen registros en pantalla para exportar.")
            return
            
        try:
            file_path = filedialog.asksaveasfilename(
                defaultextension=".csv",
                filetypes=[("Archivos CSV", "*.csv")]
            )
            if not file_path:
                return

            with open(file_path, mode="w", newline="", encoding="utf-8") as f:
                writer = csv.writer(f)
                # Encabezados formales del reporte de control de calidad
                writer.writerow(["Serial No", "Station", "Test Action", "Result Code", "Timestamp", "Operator"])
                
                for row in self.records:
                    writer.writerow(row)
                    
            messagebox.showinfo("Éxito", f"Reporte de producción guardado correctamente en:\n{file_path}")
        except Exception as e:
            messagebox.showerror("Error", f"No se pudo guardar el archivo CSV: {e}")

    def export_to_pdf(self):
        """Genera un informe ejecutivo formal en formato PDF de control de calidad."""
        if not self.records:
            messagebox.showwarning("Exportar", "No existen registros en pantalla para generar el PDF.")
            return

        try:
            file_path = filedialog.asksaveasfilename(
                defaultextension=".pdf",
                filetypes=[("Archivos PDF", "*.pdf")]
            )
            if not file_path:
                return

            doc = SimpleDocTemplate(file_path, pagesize=letter)
            styles = getSampleStyleSheet()
            story = []

            # Estilo corporativo para el encabezado del reporte
            title_style = ParagraphStyle(
                'DocTitle', 
                parent=styles['Heading1'], 
                fontSize=18, 
                textColor=colors.HexColor("#0A84FF"),
                spaceAfter=15
            )
            bu_actual = self.cmb_bu.get()
            story.append(Paragraph(f"NPI Quality Control Intelligence - Report ({bu_actual})", title_style))
            story.append(Spacer(1, 10))

            # Construcción de la matriz de datos para ReportLab
            table_data = [["Serial No", "Station", "Test", "Result", "Timestamp"]]
            for row in self.records:
                table_data.append([row[0], row[1], row[2], row[3], row[4]])

            pdf_table = Table(table_data)
            pdf_table.setStyle(TableStyle([
                ('BACKGROUND', (0, 0), (-1, 0), colors.HexColor("#131318")),
                ('TEXTCOLOR', (0, 0), (-1, 0), colors.white),
                ('ALIGN', (0, 0), (-1, -1), 'CENTER'),
                ('FONTNAME', (0, 0), (-1, 0), 'Helvetica-Bold'),
                ('BOTTOMPADDING', (0, 0), (-1, 0), 8),
                ('GRID', (0, 0), (-1, -1), 0.5, colors.grey),
                ('FONTSIZE', (0, 0), (-1, -1), 9)
            ]))
            
            story.append(pdf_table)
            doc.build(story)
            
            messagebox.showinfo("Éxito", f"Informe PDF ejecutivo generado correctamente en:\n{file_path}")
        except Exception as e:
            messagebox.showerror("Error", f"No se pudo generar el archivo PDF: {e}")


    # ======================================================
    # MÉTRICAS ANALÍTICAS Y RENDERIZADO DE GRÁFICAS
    # ======================================================

    def update_dashboard_metrics(self, total_pass, total_fail):
        """Calcula y actualiza las métricas numéricas de las tarjetas ejecutivas."""
        total_records = total_pass + total_fail
        yield_rate = 0.0
        if total_records > 0:
            yield_rate = round((total_pass / total_records) * 100, 2)

        self.lbl_card_total_val.config(text=str(total_records))
        self.lbl_card_yield_val.config(text=f"{yield_rate}%")
        self.lbl_card_pass_val.config(text=str(total_pass))
        self.lbl_card_fail_val.config(text=str(total_fail))

    def refresh_chart(self, total_pass, total_fail):
        """Redibuja de forma dinámica la gráfica de barras de Matplotlib."""
        self.ax.clear()
        
        t = self.themes["dark" if self.dark_mode else "light"]
        
        self.fig.patch.set_facecolor(t["surface"])
        self.ax.set_facecolor(t["surface_2"])
        
        categories = ["Pass (OK)", "Fail (FAIL)"]
        values = [total_pass, total_fail]
        bar_colors = [t["success"], t["danger"]]

        bars = self.ax.barh(categories, values, color=bar_colors, height=0.55)
        
        self.ax.tick_params(colors=t["text"], labelsize=9)
        self.ax.spines['top'].set_visible(False)
        self.ax.spines['right'].set_visible(False)
        self.ax.spines['left'].set_color(t["border"])
        self.ax.spines['bottom'].set_color(t["border"])
        self.ax.grid(axis='x', color=t["border"], linestyle='--', alpha=0.5)

        for bar in bars:
            width = bar.get_width()
            self.ax.text(
                width + (max(values)*0.02 if max(values) > 0 else 0.1),
                bar.get_y() + bar.get_height()/2,
                f'{int(width)}',
                va='center', ha='left',
                color=t["text"], fontweight='bold', fontsize=9
            )

        self.fig.tight_layout()
        self.canvas_plot.draw()

    # ======================================================
    # FILTRADO DE INTERFAZ Y MANEJO DE TEMAS VISUALES
    # ======================================================

    def filter_records(self):
        """Realiza un filtrado dinámico local en el Treeview por texto o estatus."""
        search_txt = self.search_var.get().upper()
        status_filter = self.cmb_status.get()
        
        for row in self.tree.get_children():
            self.tree.delete(row)

        for row in self.records:
            match_text = search_txt in str(row[0]).upper() or search_txt in str(row[1]).upper()
            match_status = True
            
            if status_filter != "Todos" and status_filter != "All" and status_filter != "":
                if status_filter in ["Pass", "OK"] and row[3] != "OK": match_status = False
                if status_filter in ["Fail", "FAIL"] and row[3] != "FAIL": match_status = False

            if match_text and match_status:
                self.tree.insert("", "end", values=row)

    def apply_theme(self, init=False):
        """Aplica la paleta de colores del tema seleccionado a todos los widgets."""
        t = self.themes["dark" if self.dark_mode else "light"]
        
        self.style.configure(".", background=t["window"], foreground=t["text"])
        self.style.configure("Treeview", background=t["surface"], foreground=t["text"], fieldbackground=t["surface"], bordercolor=t["border"], rowheight=26)
        self.style.configure("Treeview.Heading", background=t["surface_2"], foreground=t["text"], font=("Segoe UI", 9, "bold"))
        self.style.map("Treeview", background=[("selected", t["selected"])])
        
        self.root.config(bg=t["window"])
        self.app.config(bg=t["window"])
        self.header.config(bg=t["window"])
        self.title_container.config(bg=t["window"])
        self.header_buttons.config(bg=t["window"])
        self.sidebar.config(bg=t["surface"], bd=1, relief="solid", highlightbackground=t["border"])
        self.main_container.config(bg=t["window"])
        self.cards_frame.config(bg=t["window"])
        self.search_frame.config(bg=t["surface"], bd=1, relief="solid")
        self.table_frame.config(bg=t["window"])
        self.chart_frame.config(bg=t["window"])

        labels = [self.lbl_title, self.lbl_subtitle, self.lbl_controls, self.lbl_date_range, self.lbl_start, self.lbl_end, self.lbl_table_title, self.lbl_chart_title, self.lbl_filter_status, self.lbl_filter_bu]
        for lbl in labels: lbl.config(bg=lbl.master.cget("bg"), fg=t["text"])
        
        self.lbl_subtitle.config(fg=t["muted"])
        self.lbl_date_range.config(fg=t["muted"])
        self.txt_search.config(bg=t["surface"], fg=t["text"], insertbackground=t["text"])

        self.card_total.config(bg=t["card"], bd=1, relief="solid")
        self.card_yield.config(bg=t["card"], bd=1, relief="solid")
        self.card_pass.config(bg=t["card"], bd=1, relief="solid")
        self.card_fail.config(bg=t["card"], bd=1, relief="solid")
        
        for c_lbl in [self.lbl_card_total_title, self.lbl_card_total_val, self.lbl_card_yield_title, self.lbl_card_yield_val, self.lbl_card_pass_title, self.lbl_card_pass_val, self.lbl_card_fail_title, self.lbl_card_fail_val]:
            c_lbl.config(bg=c_lbl.master.cget("bg"), fg=t["text"])
            
        self.lbl_card_pass_val.config(fg=t["success"])
        self.lbl_card_fail_val.config(fg=t["danger"])

        buttons_primary = [self.btn_scan, self.btn_live]
        for btn in buttons_primary: btn.config(bg=t["accent"], fg="#FFFFFF", activebackground=t["accent_hover"], activeforeground="#FFFFFF")
        
        buttons_sec = [self.btn_lang, self.btn_theme, self.btn_reset, self.btn_delete, self.btn_export_csv, self.btn_export_pdf]
        for btn in buttons_sec: btn.config(bg=t["button_secondary"], fg=t["text"], activebackground=t["button_secondary_hover"], activeforeground=t["text"])

        if not init and self.records is not None:
            self.filter_records()
            p = sum(1 for r in self.records if r[3] == "OK")
            f = sum(1 for r in self.records if r[3] == "FAIL")
            self.refresh_chart(p, f)

