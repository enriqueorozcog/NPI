    def start_async_scan(self):
        if self.is_scanning:
            return

        self.btn_scan.config(state="disabled")
        threading.Thread(target=self.scan_server_logs, args=(True,), daemon=True).start()

    def scan_server_logs(self, show_alert=False):
        if self.is_scanning:
            return

        self.is_scanning = True

        try:
            start_date = self.date_start.get_date()
            end_date = self.date_end.get_date()
        except Exception:
            if show_alert:
                self.root.after(0, lambda: messagebox.showerror("Error", "Error al leer fechas."))
            self.finish_scan_ui()
            return

        if not os.path.exists(self.log_directory):
            ld = self.lang_dict[self.current_lang]
            if show_alert:
                self.root.after(
                    0,
                    lambda: messagebox.showerror("Error", f"{ld['path_missing']} {self.log_directory}")
                )
            self.finish_scan_ui()
            return

        files = glob.glob(os.path.join(self.log_directory, "**", "*.txt"), recursive=True)
        files += glob.glob(os.path.join(self.log_directory, "**", "*.log"), recursive=True)

        valid_files = []

        for file_path in files:
            try:
                file_date = datetime.datetime.fromtimestamp(os.path.getmtime(file_path)).date()
                if start_date <= file_date <= end_date:
                    valid_files.append(file_path)
            except Exception:
                continue

        total_files = len(valid_files)

        if total_files == 0:
            ld = self.lang_dict[self.current_lang]
            if show_alert:
                self.root.after(0, lambda: messagebox.showinfo("Scanner", ld["scanner_empty"]))
            self.finish_scan_ui()
            return

        imported = 0

        local_conn = sqlite3.connect("npi_automated_quality.db")
        local_cursor = local_conn.cursor()

        for index, file_path in enumerate(valid_files):
            serial, model, test, result, dt = LogParserEngine.parse_file(file_path)

            if serial and dt:
                try:
                    local_cursor.execute("""
                        INSERT INTO server_logs
                        (serial, model, test, result, datetime, user)
                        VALUES (?, ?, ?, ?, ?, ?)
                    """, (
                        serial,
                        model or "Unknown",
                        test or "Unknown",
                        result,
                        dt,
                        getpass.getuser()
                    ))
                    imported += 1
                except sqlite3.IntegrityError:
                    pass

            progress_value = int(((index + 1) / total_files) * 100)
            self.root.after(0, lambda p=progress_value: self.progress.configure(value=p))

        local_conn.commit()
        local_cursor.close()
        local_conn.close()

        self.root.after(0, self.load_data)

        if show_alert:
            ld = self.lang_dict[self.current_lang]
            self.root.after(
                0,
                lambda: messagebox.showinfo("Scanner", f"{ld['scanner_done']} {imported}")
            )

        self.finish_scan_ui()

    def finish_scan_ui(self):
        self.is_scanning = False
        self.root.after(0, lambda: self.progress.configure(value=0))
        self.root.after(0, lambda: self.btn_scan.config(state="normal"))

