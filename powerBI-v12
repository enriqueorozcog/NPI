    def open_log_viewer(self, event):
        selected = self.tree.selection()

        if not selected:
            return

        values = self.tree.item(selected, "values")

        if not values:
            return

        serial = str(values[0]).strip().upper()

        files = glob.glob(os.path.join(self.log_directory, "**", f"*{serial}*.*"), recursive=True)

        if not files:
            text_files = glob.glob(os.path.join(self.log_directory, "**", "*.txt"), recursive=True)
            text_files += glob.glob(os.path.join(self.log_directory, "**", "*.log"), recursive=True)

            for file_path in text_files:
                try:
                    if serial in file_path.upper():
                        files.append(file_path)
                        break
                except Exception:
                    continue

        target_file = files[0] if files else None

        if not target_file or not os.path.exists(target_file):
            ld = self.lang_dict[self.current_lang]
            messagebox.showwarning("Log Viewer", f"{ld['log_not_found']} {serial}")
            return

        theme = self.themes["dark" if self.dark_mode else "light"]

        viewer = tk.Toplevel(self.root)
        viewer.title(f"Log Viewer - {serial}")
        viewer.geometry("900x620")
        viewer.config(bg=theme["window"])

        viewer_header = tk.Frame(viewer, bg=theme["window"])
        viewer_header.pack(fill="x", padx=22, pady=(18, 10))

        title = tk.Label(
            viewer_header,
            text=f"Log Viewer · {serial}",
            bg=theme["window"],
            fg=theme["text"],
            font=("Segoe UI", 16, "bold"),
            anchor="w"
        )
        title.pack(anchor="w")

        subtitle = tk.Label(
            viewer_header,
            text=os.path.basename(target_file),
            bg=theme["window"],
            fg=theme["muted"],
            font=("Segoe UI", 9),
            anchor="w"
        )
        subtitle.pack(anchor="w", pady=(3, 0))

        text_card = tk.Frame(
            viewer,
            bg=theme["card"],
            highlightbackground=theme["border"],
            highlightthickness=1
        )
        text_card.pack(fill="both", expand=True, padx=22, pady=(0, 22))

        scroll = tk.Scrollbar(text_card)
        scroll.pack(side="right", fill="y")

        text_box = tk.Text(
            text_card,
            wrap="word",
            yscrollcommand=scroll.set,
            font=("Consolas", 10),
            bd=0,
            padx=14,
            pady=14,
            bg=theme["card"],
            fg=theme["text"],
            insertbackground=theme["text"]
        )
        text_box.pack(side="left", fill="both", expand=True)

        scroll.config(command=text_box.yview)

        try:
            with open(target_file, "r", encoding="utf-8", errors="ignore") as file:
                text_box.insert("1.0", file.read())
        except Exception as e:
            text_box.insert("1.0", f"Error: {e}")

        text_box.config(state="disabled")

