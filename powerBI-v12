    def on_search_change(self, *args):
        try:
            self.load_data()
        except Exception:
            pass

    def get_selected_status(self):
        ld = self.lang_dict[self.current_lang]
        selected = self.status_filter.get()

        if selected == ld["all"]:
            return "All"
        if selected == ld["pass"]:
            return "Pass"
        if selected == ld["fail"]:
            return "Fail"

        return "All"

    def load_data(self):
        for item in self.tree.get_children():
            self.tree.delete(item)

        try:
            start_str = self.date_start.get_date().strftime("%Y-%m-%d")
            end_str = self.date_end.get_date().strftime("%Y-%m-%d")
        except Exception:
            start_str = "2000-01-01"
            end_str = "2099-12-31"

        query = self.search_var.get().strip() if hasattr(self, "search_var") else ""
        status = self.get_selected_status() if hasattr(self, "status_filter") else "All"

        sql_query = """
            SELECT id, serial, model, test, result, datetime, user
            FROM server_logs
            WHERE date(datetime) >= date(?)
              AND date(datetime) <= date(?)
        """
        params = [start_str, end_str]

        if query:
            sql_query += " AND (serial LIKE ? OR model LIKE ?)"
            params.extend([f"%{query}%", f"%{query}%"])

        if status != "All":
            sql_query += " AND result = ?"
            params.append(status)

        sql_query += " ORDER BY datetime DESC"

        self.cursor.execute(sql_query, params)
        self.records = self.cursor.fetchall()

        theme = self.themes["dark" if self.dark_mode else "light"]

        self.tree.tag_configure(
            "pass_row",
            background=theme["pass_bg"],
            foreground=theme["text"]
        )
        self.tree.tag_configure(
            "fail_row",
            background=theme["fail_bg"],
            foreground=theme["text"]
        )

        pass_count = sum(1 for r in self.records if r[4] == "Pass")
        fail_count = sum(1 for r in self.records if r[4] == "Fail")
        total = len(self.records)
        yield_rate = round((pass_count / total) * 100, 1) if total else 100.0

        for row in self.records:
            tag = "pass_row" if row[4] == "Pass" else "fail_row"
            self.tree.insert("", "end", iid=str(row[0]), values=row[1:], tags=(tag,))

        self.update_kpis(total, yield_rate, pass_count, fail_count)
        self.update_chart(pass_count, fail_count)

    def update_kpis(self, total, yield_rate, pass_count, fail_count):
        ld = self.lang_dict[self.current_lang]

        self.kpi_cards["records"]["label"].config(text=ld["records"])
        self.kpi_cards["records"]["value"].config(text=str(total))
        self.kpi_cards["records"]["hint"].config(text="Filtered dataset")

        self.kpi_cards["yield"]["label"].config(text=ld["yield"])
        self.kpi_cards["yield"]["value"].config(text=f"{yield_rate}%")
        self.kpi_cards["yield"]["hint"].config(text="Pass / Total")

        self.kpi_cards["pass"]["label"].config(text=ld["pass"])
        self.kpi_cards["pass"]["value"].config(text=str(pass_count))
        self.kpi_cards["pass"]["hint"].config(text="Successful logs")

        self.kpi_cards["fail"]["label"].config(text=ld["fail"])
        self.kpi_cards["fail"]["value"].config(text=str(fail_count))
        self.kpi_cards["fail"]["hint"].config(text="Failed logs")

    def update_chart(self, pass_count, fail_count):
        theme = self.themes["dark" if self.dark_mode else "light"]
        ld = self.lang_dict[self.current_lang]

        self.ax.clear()
        self.fig.set_facecolor(theme["card"])
        self.ax.set_facecolor(theme["card"])

        labels = [ld["pass"], ld["fail"]]
        values = [pass_count, fail_count]
        bar_colors = [theme["success"], theme["danger"]]

        bars = self.ax.barh(labels, values, color=bar_colors, height=0.46)

        self.ax.spines["top"].set_visible(False)
        self.ax.spines["right"].set_visible(False)
        self.ax.spines["left"].set_visible(False)
        self.ax.spines["bottom"].set_color(theme["border"])

        self.ax.tick_params(colors=theme["muted"], labelsize=9)
        self.ax.grid(axis="x", color=theme["border"], linewidth=0.75, alpha=0.45)
        self.ax.set_axisbelow(True)

        max_value = max(values) if values else 0
        self.ax.set_xlim(0, max_value + max(5, max_value * 0.15))

        for bar in bars:
            width = bar.get_width()
            self.ax.text(
                width + 0.25,
                bar.get_y() + bar.get_height() / 2,
                str(int(width)),
                va="center",
                ha="left",
                color=theme["text"],
                fontsize=9,
                fontweight="bold"
            )

        self.fig.tight_layout(pad=1)
        self.canvas_plot.draw()

