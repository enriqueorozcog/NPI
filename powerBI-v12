    # ======================================================

    def export_csv(self):
        desktop = os.path.join(os.path.expanduser("~"), "Desktop")

        if not os.path.exists(desktop):
            desktop = os.path.expanduser("~")

        filename = os.path.join(
            desktop,
            f"Server_NPI_Export_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.csv"
        )

        ld = self.lang_dict[self.current_lang]

        try:
            with open(filename, mode="w", newline="", encoding="utf-8-sig") as file:
                writer = csv.writer(file, delimiter=";")
                writer.writerow([
                    ld["serial"],
                    ld["model"],
                    ld["test"],
                    ld["result"],
                    ld["datetime"],
                    ld["user"]
                ])

                for row in self.records:
                    writer.writerow(row[1:])

            messagebox.showinfo("CSV", f"Archivo exportado:\n{filename}")

        except Exception as e:
            messagebox.showerror("Error", str(e))

    def export_pdf(self):
        desktop = os.path.join(os.path.expanduser("~"), "Desktop")

        if not os.path.exists(desktop):
            desktop = os.path.expanduser("~")

        filename = os.path.join(
            desktop,
            f"NPI_Server_Report_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.pdf"
        )

        ld = self.lang_dict[self.current_lang]

        try:
            doc = SimpleDocTemplate(
                filename,
                pagesize=letter,
                rightMargin=30,
                leftMargin=30,
                topMargin=30,
                bottomMargin=30
            )

            story = []
            styles = getSampleStyleSheet()

            title_style = ParagraphStyle(
                "AppleTitle",
                parent=styles["Heading1"],
                fontName="Helvetica-Bold",
                fontSize=18,
                textColor=colors.HexColor("#007AFF"),
                spaceAfter=12
            )

            small_style = ParagraphStyle(
                "AppleSmall",
                parent=styles["Normal"],
                fontName="Helvetica",
                fontSize=8,
                leading=10
            )

            story.append(Paragraph(ld["title"], title_style))
            story.append(Spacer(1, 10))

            headers = [
                ld["serial"],
                ld["model"],
                ld["test"],
                ld["result"],
                ld["datetime"]
            ]

            table_data = [[Paragraph(f"<b>{header}</b>", small_style) for header in headers]]

            for row in self.records:
                table_data.append([Paragraph(str(item), small_style) for item in row[1:6]])

            pdf_table = Table(table_data, colWidths=[100, 90, 100, 70, 140])

            table_style = TableStyle([
                ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#F2F2F7")),
                ("TEXTCOLOR", (0, 0), (-1, 0), colors.HexColor("#1D1D1F")),
                ("GRID", (0, 0), (-1, -1), 0.35, colors.HexColor("#D8D8E0")),
                ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
                ("LEFTPADDING", (0, 0), (-1, -1), 6),
                ("RIGHTPADDING", (0, 0), (-1, -1), 6),
                ("TOPPADDING", (0, 0), (-1, -1), 5),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 5)
            ])

            for index, row in enumerate(self.records, start=1):
                row_color = "#EAF8EF" if row[4] == "Pass" else "#FDECEC"
                table_style.add("BACKGROUND", (0, index), (-1, index), colors.HexColor(row_color))

            pdf_table.setStyle(table_style)
            story.append(pdf_table)

            doc.build(story)

            messagebox.showinfo("PDF", f"Reporte PDF guardado:\n{filename}")

        except Exception as e:
            messagebox.showerror("Error", str(e))

